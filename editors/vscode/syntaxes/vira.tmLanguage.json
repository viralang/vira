{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vira",
  "scopeName": "source.vira",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#collections" },
    { "include": "#types" },
    { "include": "#quadrants" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#gui" },
    { "include": "#functions" }
  ],
  "repository": {
    "imports": {
      "patterns": [
        {
          "name": "meta.import.vira",
          "match": "\\b(import)\\s+([a-zA-Z0-9_]+)",
          "captures": {
            "1": { "name": "keyword.control.import.vira" },
            "2": { "name": "entity.name.namespace.vira" }
          }
        },
        {
          "name": "meta.import.path.vira",
          "begin": "\\b(import)\\s*(?=[(\"'`])",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.vira" }
          },
          "end": "(?<=\\))|(?<=[^\\s(])\\s*$",
          "patterns": [
            { "include": "#strings" },
            { "include": "#comments" }
          ]
        },
        {
          "name": "keyword.control.import.vira",
          "match": "\\b(import)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vira",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vira",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.vira",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vira",
              "match": "\\\\."
            },
            {
              "name": "variable.interpolation.vira",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.vira" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.vira" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.vira",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vira",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vira",
          "match": "\\b(module|import|pub|mut|fn|return|if|else|match|for|in|or|is|as|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.vira",
          "match": "\\b(struct|interface|actor|enum|type)\\b"
        },
        {
          "name": "keyword.concurrency.vira",
          "match": "\\b(spawn|supervise|actor)\\b"
        },
        {
          "name": "keyword.memory.vira",
          "match": "\\b(arena)\\b"
        },
        {
          "name": "constant.language.boolean.vira",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "quadrants": {
      "patterns": [
        {
          "name": "storage.modifier.quadrant.vira",
          "match": "\\b(pub:|mut:|pub mut:|default:)"
        }
      ]
    },
    "collections": {
      "patterns": [
        {
          "name": "support.function.method.collection.vira",
          "match": "(?<=\\.)(push|append|pop|get|set|clear|clone|contains|is_empty)\\b(?=\\s*\\()"
        },
        {
          "name": "support.variable.property.collection.vira",
          "match": "(?<=\\.)(len|cap)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "meta.type.array.vira",
          "match": "(\\[)\\s*([0-9_]*)\\s*(\\])\\s*([a-zA-Z0-9_]+)",
          "captures": {
            "1": { "name": "punctuation.bracket.square.vira" },
            "2": { "name": "constant.numeric.integer.vira" },
            "3": { "name": "punctuation.bracket.square.vira" },
            "4": { "name": "entity.name.type.vira" }
          }
        },
        {
          "name": "entity.name.type.primitive.vira",
          "match": "\\b(int|i64|f32|f16|bf16|f64|bool|string|void)\\b"
        },
        {
          "name": "entity.name.type.tensor.vira",
          "match": "\\b(tensor)\\[(f32|f16|bf16|f64)\\]"
        },
        {
          "name": "entity.name.type.future.vira",
          "match": "\\b(Future)\\[[a-zA-Z0-9_]+\\]"
        },
        {
          "name": "entity.name.type.user.vira",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ai.matmul.vira",
          "match": "@"
        },
        {
          "name": "keyword.operator.actor.send.vira",
          "match": "<-"
        },
        {
          "name": "keyword.operator.arrow.vira",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.vira",
          "match": "(:=|\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.vira",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.vira",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.vira",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.result.vira",
          "match": "(\\?|!)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vira",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.hex.vira",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.integer.vira",
          "match": "\\b[0-9_]+(i64)?\\b"
        }
      ]
    },
    "gui": {
      "patterns": [
        {
          "name": "support.function.builtin.gui.lifecycle.vira",
          "match": "\\b(gui_init|gui_should_close|gui_cancel_close|gui_set_target_fps|gui_window_width|gui_window_height|gui_begin|gui_end|gui_close|gui_clear|gui_frame_time|gui_poll)\\b"
        },
        {
          "name": "support.function.builtin.gui.layout.vira",
          "match": "\\b(gui_vstack_begin|gui_hstack_begin|gui_stack_end|gui_spacing|gui_card_begin|gui_card_end|gui_separator|gui_badge)\\b"
        },
        {
          "name": "support.function.builtin.gui.widgets.vira",
          "match": "\\b(gui_btn|gui_check|gui_slide|gui_lbl|gui_input|gui_progress|gui_radio|gui_button|gui_slider|gui_checkbox|gui_label|gui_text_input|gui_progress_bar|gui_radio_button)\\b"
        },
        {
          "name": "support.function.builtin.gui.navigation.vira",
          "match": "\\b(gui_tab_item|gui_modal_begin|gui_modal_end)\\b"
        },
        {
          "name": "support.function.builtin.gui.drawing.vira",
          "match": "\\b(gui_draw_text|gui_draw_rect|gui_draw_circle|gui_draw_line|gui_draw_badge)\\b"
        },
        {
          "name": "support.function.builtin.gui.input.vira",
          "match": "\\b(gui_mouse_x|gui_mouse_y|gui_is_mouse_down|gui_is_key_pressed|gui_get_mouse_x|gui_get_mouse_y|gui_get_mouse_down|gui_get_char_pressed|gui_is_key_down)\\b"
        },
        {
          "name": "support.function.builtin.gui.vira",
          "match": "\\b(gui_[a-zA-Z0-9_]+)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.vira",
          "match": "\\b(println|eprintln|panic|file_exists|read_file|write_file|append_file|remove_file|net_listen|net_accept|net_read|net_write|net_close|http_response|json_get_str|json_get_int|json_get_f32|time_now_ns|time_sleep_ms|arena_alloc|arena_reset|arena_free|tensor_fill|tensor_sum|tensor_relu|tensor_add|tensor_scale|tensor_load_bin|tensor_save_bin|tensor_transpose|tensor_matmul_grad_a|tensor_matmul_grad_b|tensor_relu_backward|tensor_sgd_step|safetensors_load|gguf_load|gguf_load_tensor|gguf_tensor_dequant|tensor_rmsnorm|tensor_rope|tensor_silu|tensor_elemwise_mul|tensor_softmax|tensor_embedding|rmsnorm|rope|swiglu|causal_self_attention|sample_token|sample_argmax|sample_top_p|gui_init|gui_should_close|gui_cancel_close|gui_set_target_fps|gui_window_width|gui_window_height|gui_begin|gui_end|gui_close|gui_clear|gui_frame_time|gui_poll|gui_draw_text|gui_draw_rect|gui_draw_circle|gui_draw_line|gui_draw_badge|gui_button|gui_slider|gui_checkbox|gui_label|gui_text_input|gui_progress_bar|gui_radio_button|gui_mouse_x|gui_mouse_y|gui_is_mouse_down|gui_is_key_pressed|gui_get_mouse_x|gui_get_mouse_y|gui_get_mouse_down|gui_get_char_pressed|gui_is_key_down|gui_vstack_begin|gui_hstack_begin|gui_stack_end|gui_spacing|gui_card_begin|gui_card_end|gui_separator|gui_badge|gui_btn|gui_check|gui_slide|gui_lbl|gui_input|gui_progress|gui_radio|gui_tab_item|gui_modal_begin|gui_modal_end)\\b"
        },
        {
          "name": "entity.name.function.vira",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}
