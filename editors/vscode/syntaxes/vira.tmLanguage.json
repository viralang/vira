{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vex",
  "scopeName": "source.vir",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#quadrants" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vir",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vir",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.vir",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vir",
              "match": "\\\\."
            },
            {
              "name": "variable.interpolation.vir",
              "match": "\\$\\{[^\\}]+\\}"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vir",
          "match": "\\b(module|import|pub|mut|fn|return|if|else|match|for|in|or|is|as|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.vir",
          "match": "\\b(struct|interface|actor|enum|type)\\b"
        },
        {
          "name": "keyword.memory.vir",
          "match": "\\b(arena)\\b"
        },
        {
          "name": "constant.language.boolean.vir",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "quadrants": {
      "patterns": [
        {
          "name": "storage.modifier.quadrant.vir",
          "match": "\\b(pub:|mut:|pub mut:|default:)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.vir",
          "match": "\\b(int|i64|f32|bf16|f64|bool|string|void)\\b"
        },
        {
          "name": "entity.name.type.tensor.vir",
          "match": "\\b(tensor)\\[(f32|bf16|f64)\\]"
        },
        {
          "name": "entity.name.type.future.vir",
          "match": "\\b(Future)\\[[a-zA-Z0-9_]+\\]"
        },
        {
          "name": "entity.name.type.user.vir",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ai.matmul.vir",
          "match": "@"
        },
        {
          "name": "keyword.operator.actor.send.vir",
          "match": "<-"
        },
        {
          "name": "keyword.operator.assignment.vir",
          "match": "(:=|\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.vir",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.vir",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.vir",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.result.vir",
          "match": "(\\?|!)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vir",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.hex.vir",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.integer.vir",
          "match": "\\b[0-9_]+(i64)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.vir",
          "match": "\\b(println|eprintln|panic|tensor_fill|tensor_sum|tensor_relu|tensor_add|tensor_scale|tensor_load_bin|tensor_save_bin|file_exists|read_file|write_file|append_file|remove_file)\\b"
        },
        {
          "name": "entity.name.function.vir",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}
