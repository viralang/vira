{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vira",
  "scopeName": "source.vira",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#modules" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#gui" },
    { "include": "#widgets" },
    { "include": "#collections" },
    { "include": "#functions" },
    { "include": "#properties" },
    { "include": "#types" },
    { "include": "#quadrants" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.directive.vira",
          "match": "^\\s*(#(?:include|flag))\\s+(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.vira" },
            "2": { "name": "string.unquoted.directive.vira" }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.vira",
          "match": "(@\\[\\s*)([a-zA-Z0-9_]+)(?:\\s*:\\s*('[^']*'|\"[^\"]*\"))?(\\s*\\])",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.begin.vira" },
            "2": { "name": "entity.name.function.attribute.vira" },
            "3": { "name": "string.quoted.attribute.vira" },
            "4": { "name": "punctuation.definition.annotation.end.vira" }
          }
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "meta.module.vira",
          "match": "\\b(module)\\s+([a-zA-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "keyword.control.module.vira" },
            "2": { "name": "entity.name.namespace.vira" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.alias.vira",
          "match": "\\b(import)\\s+([a-zA-Z0-9_]+)\\s+(as)\\s+([a-zA-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.vira" },
            "2": { "name": "entity.name.namespace.vira" },
            "3": { "name": "keyword.control.import.as.vira" },
            "4": { "name": "entity.name.namespace.alias.vira" }
          }
        },
        {
          "name": "meta.import.string.alias.vira",
          "match": "\\b(import)\\s+('[^']*'|\"[^\"]*\")\\s+(as)\\s+([a-zA-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.vira" },
            "2": { "name": "string.quoted.import.vira" },
            "3": { "name": "keyword.control.import.as.vira" },
            "4": { "name": "entity.name.namespace.alias.vira" }
          }
        },
        {
          "name": "meta.import.simple.vira",
          "match": "\\b(import)\\s+([a-zA-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.vira" },
            "2": { "name": "entity.name.namespace.vira" }
          }
        },
        {
          "name": "keyword.control.import.vira",
          "match": "\\b(import)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.static.vira",
          "match": "\\b(pub\\s+)?(fn)\\s+([A-Z][a-zA-Z0-9_]*)\\.([a-zA-Z0-9_]+)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.modifier.pub.vira" },
            "2": { "name": "keyword.declaration.function.vira" },
            "3": { "name": "entity.name.type.vira" },
            "4": { "name": "entity.name.function.member.static.vira" }
          }
        },
        {
          "name": "meta.function.receiver.vira",
          "match": "\\b(pub\\s+)?(fn)\\s*(\\()\\s*([a-zA-Z0-9_]+)\\s*(&)?([A-Z][a-zA-Z0-9_]*)\\s*(\\))\\s*([a-zA-Z0-9_]+)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.modifier.pub.vira" },
            "2": { "name": "keyword.declaration.function.vira" },
            "3": { "name": "punctuation.definition.parameters.begin.vira" },
            "4": { "name": "variable.parameter.receiver.vira" },
            "5": { "name": "keyword.operator.reference.vira" },
            "6": { "name": "entity.name.type.vira" },
            "7": { "name": "punctuation.definition.parameters.end.vira" },
            "8": { "name": "entity.name.function.member.vira" }
          }
        },
        {
          "name": "meta.function.top.vira",
          "match": "\\b(pub\\s+)?(fn)\\s+([a-zA-Z0-9_]+)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.modifier.pub.vira" },
            "2": { "name": "keyword.declaration.function.vira" },
            "3": { "name": "entity.name.function.declaration.vira" }
          }
        },
        {
          "name": "meta.type.declaration.vira",
          "match": "\\b(pub\\s+)?(struct|interface|actor|enum|type)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.pub.vira" },
            "2": { "name": "keyword.declaration.type.vira" },
            "3": { "name": "entity.name.type.class.vira" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vira",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vira",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.vira",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vira",
              "match": "\\\\."
            },
            {
              "name": "variable.interpolation.vira",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.vira" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.vira" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            },
            {
              "name": "variable.interpolation.shorthand.vira",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        },
        {
          "name": "string.quoted.double.vira",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vira",
              "match": "\\\\."
            },
            {
              "name": "variable.interpolation.vira",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.vira" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.vira" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            },
            {
              "name": "variable.interpolation.shorthand.vira",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vira",
          "match": "\\b(module|import|pub|mut|const|defer|fn|return|if|else|switch|case|default|match|for|in|or|is|as|break|continue|extern|unsafe)\\b"
        },
        {
          "name": "keyword.declaration.vira",
          "match": "\\b(struct|interface|actor|enum|type)\\b"
        },
        {
          "name": "keyword.concurrency.vira",
          "match": "\\b(spawn|supervise|actor)\\b"
        },
        {
          "name": "keyword.memory.vira",
          "match": "\\b(arena)\\b"
        },
        {
          "name": "constant.language.boolean.vira",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.vira",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "meta.constant.qualified.vira",
          "match": "\\b([a-zA-Z0-9_]+)\\.([A-Z][A-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.vira" },
            "2": { "name": "constant.other.caps.vira" }
          }
        },
        {
          "name": "constant.other.caps.vira",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "widgets": {
      "patterns": [
        {
          "name": "meta.call.chained.static.vira",
          "match": "\\b([a-zA-Z0-9_]+)\\.([A-Z][a-zA-Z0-9_]*)\\.([a-zA-Z0-9_]+)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.vira" },
            "2": { "name": "entity.name.type.vira" },
            "3": { "name": "entity.name.function.member.static.vira" }
          }
        },
        {
          "name": "meta.call.static.vira",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\.([a-zA-Z0-9_]+)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.type.vira" },
            "2": { "name": "entity.name.function.member.static.vira" }
          }
        },
        {
          "name": "meta.call.widget.qualified.vira",
          "match": "\\b([a-zA-Z0-9_]+)\\.([A-Z][a-zA-Z0-9_]*)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.vira" },
            "2": { "name": "entity.name.function.widget.vira" }
          }
        },
        {
          "name": "meta.call.func.qualified.vira",
          "match": "\\b([a-zA-Z0-9_]+)\\.([a-z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.vira" },
            "2": { "name": "entity.name.function.call.vira" }
          }
        },
        {
          "name": "entity.name.function.widget.vira",
          "match": "\\b(App|Scaffold|Card|Column|Row|Padding|Center|Spacer|Divider|Heading|Subheading|Text|Caption|ElevatedButton|SecondaryButton|DangerButton|TextField|Slider|Dropdown|DataTable|ProgressBar|Badge|StatusBadge|Image|LoadImage|FreeImage|MediaQuery|EdgeInsets|Theme)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.constructor.vira",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "quadrants": {
      "patterns": [
        {
          "name": "storage.modifier.quadrant.vira",
          "match": "\\b(pub:|mut:|pub mut:|default:)"
        }
      ]
    },
    "collections": {
      "patterns": [
        {
          "name": "support.function.method.collection.vira",
          "match": "(?<=\\.)(push|append|pop|get|set|clear|clone|contains|is_empty|to_string|to_str|index_of|last_index_of|substr|slice|starts_with|ends_with|split|replace|repeat|lines|byte_at|trim|trim_left|trim_right|to_lower|to_upper|to_int|to_i64|to_f64|to_f32|bytes|to_bytes|numel|dim|stride|reshape_2d|reshape_3d|reshape_4d|transpose|await)\\b(?=\\s*\\()"
        },
        {
          "name": "support.variable.property.collection.vira",
          "match": "(?<=\\.)(len|cap|ndim|rows|cols)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.vira",
          "match": "(?<=\\.)([a-z_][a-zA-Z0-9_]*)\\b(?![a-zA-Z0-9_]*\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "meta.type.array.vira",
          "match": "(\\[)\\s*([0-9_]*)\\s*(\\])\\s*([a-zA-Z0-9_]+)",
          "captures": {
            "1": { "name": "punctuation.bracket.square.vira" },
            "2": { "name": "constant.numeric.integer.vira" },
            "3": { "name": "punctuation.bracket.square.vira" },
            "4": { "name": "entity.name.type.vira" }
          }
        },
        {
          "name": "entity.name.type.primitive.vira",
          "match": "\\b(u8|byte|int|i64|f32|f16|bf16|f64|bool|string|void|c_char|c_uchar|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_size|c_ssize|c_float|c_double|voidptr)\\b"
        },
        {
          "name": "entity.name.type.tensor.vira",
          "match": "\\b(tensor)\\[(f32|f16|bf16|f64)\\]"
        },
        {
          "name": "entity.name.type.future.vira",
          "match": "\\b(Future)\\[[a-zA-Z0-9_]+\\]"
        },
        {
          "name": "meta.type.qualified.vira",
          "match": "\\b([a-zA-Z0-9_]+)\\.([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.vira" },
            "2": { "name": "entity.name.type.user.vira" }
          }
        },
        {
          "name": "entity.name.type.user.vira",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ai.matmul.vira",
          "match": "@"
        },
        {
          "name": "keyword.operator.actor.send.vira",
          "match": "<-"
        },
        {
          "name": "keyword.operator.arrow.vira",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.vira",
          "match": "(:=|\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.vira",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.vira",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.vira",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.result.vira",
          "match": "(\\?|!)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vira",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?(f32|f64|f16|bf16)?\\b"
        },
        {
          "name": "constant.numeric.float.scientific.vira",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+(f32|f64|f16|bf16)?\\b"
        },
        {
          "name": "constant.numeric.hex.vira",
          "match": "\\b0x[0-9a-fA-F_]+(i64|u8|byte|int)?\\b"
        },
        {
          "name": "constant.numeric.octal.vira",
          "match": "\\b0o[0-7_]+(i64|u8|byte|int)?\\b"
        },
        {
          "name": "constant.numeric.binary.vira",
          "match": "\\b0b[01_]+(i64|u8|byte|int)?\\b"
        },
        {
          "name": "constant.numeric.integer.vira",
          "match": "\\b[0-9][0-9_]*(f32|f64|f16|bf16|i64|u8|byte|int)?\\b"
        }
      ]
    },
    "gui": {
      "patterns": [
        {
          "name": "support.function.builtin.gui.lifecycle.vira",
          "match": "\\b(gui_init|gui_should_close|gui_cancel_close|gui_set_target_fps|gui_window_width|gui_window_height|gui_begin|gui_end|gui_close|gui_clear|gui_frame_time|gui_poll)\\b"
        },
        {
          "name": "support.function.builtin.gui.layout.vira",
          "match": "\\b(gui_vstack_begin|gui_hstack_begin|gui_stack_end|gui_spacing|gui_card_begin|gui_card_end|gui_separator|gui_badge)\\b"
        },
        {
          "name": "support.function.builtin.gui.widgets.vira",
          "match": "\\b(gui_btn|gui_btn_danger|gui_check|gui_slide|gui_lbl|gui_input|gui_progress|gui_radio|gui_button|gui_slider|gui_checkbox|gui_label|gui_text_input|gui_progress_bar|gui_radio_button)\\b"
        },
        {
          "name": "support.function.builtin.gui.tables.vira",
          "match": "\\b(gui_table|gui_tbl|gui_dropdown|gui_select|gui_table_sort_col|gui_table_sort_asc|gui_table_set_sort)\\b"
        },
        {
          "name": "support.function.builtin.gui.images.vira",
          "match": "\\b(gui_load_image|gui_free_image|gui_image|gui_image_width|gui_image_height|gui_draw_image)\\b"
        },
        {
          "name": "support.function.builtin.gui.navigation.vira",
          "match": "\\b(gui_tab_item|gui_modal_begin|gui_modal_end)\\b"
        },
        {
          "name": "support.function.builtin.gui.drawing.vira",
          "match": "\\b(gui_draw_text|gui_draw_rect|gui_draw_circle|gui_draw_line|gui_draw_badge)\\b"
        },
        {
          "name": "support.function.builtin.gui.input.vira",
          "match": "\\b(gui_mouse_x|gui_mouse_y|gui_is_mouse_down|gui_is_key_pressed|gui_get_mouse_x|gui_get_mouse_y|gui_get_mouse_down|gui_get_char_pressed|gui_is_key_down)\\b"
        },
        {
          "name": "support.function.builtin.gui.vira",
          "match": "\\b(gui_[a-zA-Z0-9_]+)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.vira",
          "match": "\\b(print|println|eprint|eprintln|panic|file_exists|read_file|write_file|append_file|remove_file|net_listen|net_accept|net_read|net_write|net_close|http_response|json_get_str|json_get_int|json_get_f32|json_is_valid|time_now_us|time_now_ms|time_sleep_ms|arena_alloc|arena_reset|arena_free|tensor_fill|tensor_fill_3d|tensor_fill_4d|tensor_sum|tensor_relu|tensor_add|tensor_scale|tensor_elemwise_mul|tensor_silu|tensor_softmax|tensor_embedding|tensor_transpose|tensor_load_bin|tensor_save_bin|tensor_matmul_grad_a|tensor_matmul_grad_b|tensor_relu_backward|tensor_sgd_step|safetensors_load|gguf_load|gguf_load_tensor|gguf_tensor_dequant|tensor_rmsnorm|tensor_rope|rmsnorm|rope|swiglu|causal_self_attention|sample_token|sample_argmax|sample_top_p)\\b"
        },
        {
          "name": "entity.name.function.member.vira",
          "match": "(?<=\\.)([a-zA-Z0-9_]+)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.vira",
          "match": "\\b([a-zA-Z0-9_]+)\\b(?=\\s*\\()"
        }
      ]
    }
  }
}
