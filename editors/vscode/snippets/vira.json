{
  "For In Loop": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over an array, slice, or string collection"
  },
  "Fixed Array Declaration": {
    "prefix": "arr",
    "body": [
      "mut ${1:arr} := [${2:4}]${3:int}{${4:10, 20, 30, 40}}"
    ],
    "description": "Fixed-size stack-allocated array [N]T"
  },
  "Dynamic Slice Declaration": {
    "prefix": "slice",
    "body": [
      "mut ${1:items} := [${2:1, 2, 3}]"
    ],
    "description": "Growable dynamic slice []T"
  },
  "Slice Push": {
    "prefix": "push",
    "body": [
      "${1:items}.push(${2:val})"
    ],
    "description": "Push element into dynamic slice"
  },
  "Collection Safe Get": {
    "prefix": "getor",
    "body": [
      "${1:val} := ${2:items}.get(${3:index}) or { ${4:default_val} }"
    ],
    "description": "Safely read element by index with default fallback"
  },
  "Switch Statement": {
    "prefix": "switch",
    "body": [
      "switch ${1:expr} {",
      "case ${2:val}:",
      "\t${3}",
      "default:",
      "\t$0",
      "}"
    ],
    "description": "Switch statement with cases and default"
  },
  "Module Declaration": {
    "prefix": "mod",
    "body": [
      "module ${1:name}"
    ],
    "description": "Declare package module namespace"
  },
  "Import with Alias": {
    "prefix": "impas",
    "body": [
      "import ${1:package} as ${2:alias}"
    ],
    "description": "Import package with local namespace alias"
  },
  "3D Strided Tensor": {
    "prefix": "tensor3d",
    "body": [
      "${1:hidden} := tensor_fill_3d(${2:2}, ${3:16}, ${4:64}, ${5:0.5})"
    ],
    "description": "Allocate 3D strided tensor[f32] (Batch x Seq x Hidden)"
  },
  "4D Multi-Head Attention Arena": {
    "prefix": "tensor4d",
    "body": [
      "arena {",
      "\t${1:q} := tensor_fill_4d(${2:2}, ${3:8}, ${4:16}, ${5:64}, ${6:0.125})",
      "\t${7:k} := ${1:q}.transpose()",
      "\t${8:scores} := ${1:q} @ ${7:k}",
      "\t$0",
      "}"
    ],
    "description": "4D batched multi-head attention inside O(1) bump arena"
  },
  "JSON Builder": {
    "prefix": "jsonb",
    "body": [
      "mut ${1:jb} := json.JsonBuilder.new()",
      "${1:jb}.set_str('${2:status}', '${3:ok}')",
      "${4:payload} := ${1:jb}.build()"
    ],
    "description": "Build RFC 8259 JSON object using stdlib json.JsonBuilder"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} := ${2:value}"
    ],
    "description": "Compile-time constant declaration"
  },
  "Defer Statement": {
    "prefix": "defer",
    "body": [
      "defer {",
      "\t${1:// cleanup}",
      "}"
    ],
    "description": "Execute block at function exit in LIFO order"
  },
  "Command-Line FlagSet": {
    "prefix": "flagset",
    "body": [
      "mut ${1:fs} := flag.FlagSet.new('${2:app}')",
      "${1:fs}.bool('${3:verbose}', false, '${4:enable verbose output}')",
      "${1:fs}.string('${5:config}', '${6:config.json}', '${7:path to configuration file}')",
      "${1:fs}.parse(os.args()) or {",
      "\teprintln('Error: ${err}')",
      "\treturn",
      "}"
    ],
    "description": "Parse CLI flags using stdlib flag.FlagSet"
  },
  "Structured Logger": {
    "prefix": "logger",
    "body": [
      "mut ${1:l} := log.Logger.new('${2:app}')",
      "${1:l}.info('${3:Ready}')"
    ],
    "description": "Structured logging with prefix and severity"
  },
  "Process Command Execution": {
    "prefix": "exec",
    "body": [
      "mut ${1:cmd} := exec.Command.new('${2:echo}', [${3:'Hello from Vira'}])",
      "${4:res} := ${1:cmd}.run() or {",
      "\teprintln('Command execution failed: ${err}')",
      "\treturn",
      "}"
    ],
    "description": "Spawn child process using stdlib exec.Command"
  },
  "Widget App Boilerplate": {
    "prefix": "wapp",
    "body": [
      "module main",
      "",
      "import widget as w",
      "",
      "fn main() {",
      "\tmut app := w.App.new('${1:Vira App}', ${2:800}, ${3:600})",
      "\tapp.init()",
      "\tdefer app.cleanup()",
      "",
      "\ttheme := w.Theme.mocha()",
      "",
      "\tfor !app.should_close() {",
      "\t\tapp.begin_frame(theme.bg_color)",
      "\t\tw.Scaffold.begin(theme)",
      "",
      "\t\tw.Padding.begin(w.EdgeInsets.all(${4:24}), w.window_width(), ${5:12})",
      "\t\tw.Card.begin('${6:Dashboard}', w.content_width(${4:24}))",
      "",
      "\t\tw.Heading('${7:Welcome to Vira}')",
      "\t\tw.Text('${8:Hardware-accelerated native GUI with zero garbage collection.}')",
      "\t\tw.Spacer(6)",
      "",
      "\t\t$0",
      "",
      "\t\tw.Card.end()",
      "\t\tw.Padding.end()",
      "",
      "\t\tw.Scaffold.end()",
      "\t\tapp.end_frame()",
      "\t}",
      "}"
    ],
    "description": "Scaffold a complete Flutter-style responsive GUI application"
  },
  "Widget Card": {
    "prefix": "wcard",
    "body": [
      "w.Card.begin('${1:Title}', w.content_width(${2:24}))",
      "$0",
      "w.Card.end()"
    ],
    "description": "Framed elevation Card with header and borders"
  },
  "Widget Row": {
    "prefix": "wrow",
    "body": [
      "w.Row.begin(${1:36}, ${2:12})",
      "$0",
      "w.Row.end()"
    ],
    "description": "Horizontal auto-stack row container"
  },
  "Widget Column": {
    "prefix": "wcol",
    "body": [
      "w.Column.begin(${1:10})",
      "$0",
      "w.Column.end()"
    ],
    "description": "Vertical auto-stack column container"
  },
  "Widget Elevated Button": {
    "prefix": "wbtn",
    "body": [
      "if w.ElevatedButton('${1:Click Me}') {",
      "\t$0",
      "}"
    ],
    "description": "Primary theme action button with click event handler"
  },
  "Widget Danger Button": {
    "prefix": "wbtndanger",
    "body": [
      "if w.DangerButton('${1:Delete}') {",
      "\t$0",
      "}"
    ],
    "description": "Destructive red action button"
  },
  "Widget Secondary Button": {
    "prefix": "wbtnsec",
    "body": [
      "if w.SecondaryButton('${1:Cancel}') {",
      "\t$0",
      "}"
    ],
    "description": "Secondary outline action button"
  },
  "Widget Slider": {
    "prefix": "wslider",
    "body": [
      "${1:val} = w.Slider('${2:Gain}', ${1:val}, ${3:0.0f32}, ${4:100.0f32})"
    ],
    "description": "Interactive draggable slider control"
  },
  "Widget Text Field": {
    "prefix": "winput",
    "body": [
      "${1:text} = w.TextField('${2:Placeholder}', ${1:text})"
    ],
    "description": "Interactive text input field"
  },
  "Widget Dropdown": {
    "prefix": "wdrop",
    "body": [
      "${1:selected} = w.Dropdown(${2:options}, ${1:selected})"
    ],
    "description": "Deferred top-layer overlay dropdown select"
  },
  "Widget Progress Bar": {
    "prefix": "wprogress",
    "body": [
      "w.ProgressBar(${1:progress}, ${2:100})"
    ],
    "description": "Horizontal percentage progress bar"
  },
  "Widget Status Badge": {
    "prefix": "wstatus",
    "body": [
      "w.StatusBadge('${1:System: Healthy}', ${2:true})"
    ],
    "description": "System health status pill badge"
  },
  "Widget Media Query": {
    "prefix": "wmedia",
    "body": [
      "mq := w.MediaQuery.of()",
      "if mq.is_mobile {",
      "\t${1:// compact mobile layout}",
      "} else {",
      "\t${2:// full desktop layout}",
      "}"
    ],
    "description": "Responsive screen breakpoint inspection via MediaQuery"
  }
}
