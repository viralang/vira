{
  "name": "vira-language",
  "displayName": "Vira Programming Language",
  "description": "Rich language support, syntax highlighting, and LSP integration for the Vira Programming Language.",
  "version": "0.1.5",
  "publisher": "viralang",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/viralang/vira"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vira"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vira",
        "aliases": [
          "Vira",
          "vira"
        ],
        "extensions": [
          ".vir",
          ".vex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vira",
        "scopeName": "source.vira",
        "path": "./syntaxes/vira.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vira",
        "path": "./snippets/vira.json"
      }
    ],
    "commands": [
      {
        "command": "vira.restartServer",
        "title": "Vira: Restart Language Server"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Vira Language Server",
      "properties": {
        "vira.compilerPath": {
          "type": "string",
          "default": "vira",
          "description": "Path to the Vira compiler executable (defaults to 'vira' in PATH or ~/.vira/bin/vira)"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-git-tag-version"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}