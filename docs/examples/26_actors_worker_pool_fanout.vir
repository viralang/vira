module worker_pool_demo

// ==============================================================================
// Tutorial 26: High-Throughput Actor Worker Pool & Matrix Fan-Out / Fan-In
//
// Demonstrates:
// 1. Array of Actor Workers: Managing multiple independent actor instances.
// 2. Parallel Fan-Out (`<-`): Concurrently dispatching compute-intensive SIMD
//    matrix multiplication tasks across the Chase-Lev work-stealing pool.
// 3. Work-Helping Fan-In (`.await()`): Synchronizing futures without thread stalls.
// 4. Zero-Leak Memory Management: Private actor scratch arenas wiped in O(1).
// ==============================================================================

pub actor MatrixWorker {
pub:
	id int
mut:
	tasks_completed int = 0
}

pub fn (mut w MatrixWorker) compute_tile(tile_id int, dim int, scale f32) f32 {
	w.tasks_completed = w.tasks_completed + 1

	// SIMD AVX2/FMA Matrix multiplication: weights @ inputs
	weights := tensor_fill(dim, dim, 0.25)
	inputs := tensor_fill(dim, dim, scale)
	product := weights @ inputs

	sum := tensor_sum(product)
	println('[Worker #${w.id}] Finished Tile #${tile_id} (${dim}x${dim}) -> sum=${sum}')
	return sum
}

fn main() {
	println('=================================================================')
	println('   VIRA ACTOR SYSTEM: MATRIX FAN-OUT / FAN-IN WORKER POOL        ')
	println('=================================================================')

	// 1. Spawn a pool of 4 independent MatrixWorker actors
	println('')
	println('--- 1. SPAWNING ACTOR WORKER CLUSTER ---')
	mut w0 := MatrixWorker{ id: 0, tasks_completed: 0 }
	mut w1 := MatrixWorker{ id: 1, tasks_completed: 0 }
	mut w2 := MatrixWorker{ id: 2, tasks_completed: 0 }
	mut w3 := MatrixWorker{ id: 3, tasks_completed: 0 }
	println('✓ Cluster ready with 4 workers mapped to Chase-Lev work-stealing pool')

	// 2. Asynchronously fan-out 8 compute tiles across the cluster
	println('')
	println('--- 2. ASYNCHRONOUS FAN-OUT (<-) OF 8 SIMD TILES ---')
	fut0 := w0 <- compute_tile(100, 32, 1.0)
	fut1 := w1 <- compute_tile(101, 32, 1.5)
	fut2 := w2 <- compute_tile(102, 32, 2.0)
	fut3 := w3 <- compute_tile(103, 32, 2.5)
	fut4 := w0 <- compute_tile(104, 32, 3.0)
	fut5 := w1 <- compute_tile(105, 32, 3.5)
	fut6 := w2 <- compute_tile(106, 32, 4.0)
	fut7 := w3 <- compute_tile(107, 32, 4.5)
	println('✓ 8 asynchronous tasks dispatched across workers')

	// 3. Fan-in: Await and aggregate all tile results
	println('')
	println('--- 3. FAN-IN AGGREGATION & WORK-HELPING AWAIT ---')
	r0 := fut0.await() or { 0.0 }
	r1 := fut1.await() or { 0.0 }
	r2 := fut2.await() or { 0.0 }
	r3 := fut3.await() or { 0.0 }
	r4 := fut4.await() or { 0.0 }
	r5 := fut5.await() or { 0.0 }
	r6 := fut6.await() or { 0.0 }
	r7 := fut7.await() or { 0.0 }

	total_sum := r0 + r1 + r2 + r3 + r4 + r5 + r6 + r7
	println('All 8 SIMD compute tiles aggregated successfully!')
	println('Total Matrix Energy Sum: ${total_sum}')

	println('')
	println('=================================================================')
	println('✓ FAN-OUT / FAN-IN WORKER POOL COMPLETED WITH 0 LEAKS!           ')
	println('=================================================================')
}
