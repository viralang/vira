module deep_dive_tensors

// Model weights encapsulated in an immutable struct
pub struct MlpWeights {
pub:
	w_proj  tensor[f32]
	w_layer tensor[f32]
}

// Actor for parallel multicore model serving (Zero GIL, Lock-Free)
pub actor ModelServer {
pub:
	server_id int
mut:
	batches_served int = 0
}

pub fn (mut s ModelServer) forward_pass(multiplier f32) f32 {
	s.batches_served = s.batches_served + 1

	mut total := 0.0f32
	arena {
		inputs := tensor_fill(32, 64, multiplier)
		w_proj := tensor_fill(64, 128, 0.05f32)
		w_layer := tensor_fill(128, 32, 0.02f32)
		h1 := inputs @ w_proj
		out := h1 @ w_layer
		total = tensor_sum(out)
	}
	return total
}

fn main() {
	println('=================================================================')
	println('   VEX FIRST-CLASS AI TENSORS & SIMD ACCELERATION DEEP DIVE      ')
	println('=================================================================')

	println('--- 1. FIRST-CLASS TENSOR CREATION & MEMORY ALIGNMENT ---')
	// Batch size: 32, Sequence / Embedding Dimension: 64
	inputs := tensor_fill(32, 64, 1.0f32)
	w_hidden := tensor_fill(64, 128, 0.05f32)
	w_output := tensor_fill(128, 32, 0.02f32)

	println('Allocated 64-byte aligned tensors:')
	println('  Inputs:   (32 x 64)  = 2,048 f32 elements')
	println('  W_hidden: (64 x 128) = 8,192 f32 elements')
	println('  W_output: (128 x 32) = 4,096 f32 elements')

	println('--- 2. HARDWARE SIMD MATRIX MULTIPLICATION (@) ---')
	// Vex compiles the '@' operator directly into AVX2+FMA or ARM NEON instructions
	// Executing 8 single-precision FMAs per clock cycle
	hidden_activations := inputs @ w_hidden
	output_logits := hidden_activations @ w_output

	sum_hidden := tensor_sum(hidden_activations)
	sum_logits := tensor_sum(output_logits)

	println('Layer 1 (Inputs @ W_hidden): (32 x 128) -> Sum = ${sum_hidden}')
	println('Layer 2 (Hidden @ W_output): (32 x 32)  -> Sum = ${sum_logits}')

	println('--- 3. ZERO-ALLOCATION BUMP ARENA INFERENCE ---')
	// Temporary batch allocations in an arena avoid heap fragmentation
	weights := MlpWeights{
		w_proj:  w_hidden,
		w_layer: w_output,
	}

	arena {
		println('Executing 10 consecutive MLP forward passes inside 64KB Bump Arena...')
		mut arena_total := 0.0f32
		for mut step := 1; step <= 10; step += 1 {
			batch := tensor_fill(16, 64, 0.25f32)
			h := batch @ weights.w_proj
			y := h @ weights.w_layer
			arena_total += tensor_sum(y)
		}
		println('Completed 10 passes inside arena -> Cumulative Sum: ${arena_total}')
	}
	println('Arena block exited: All activation slabs wiped in O(1) without free() calls')

	println('--- 4. MULTICORE PARALLEL SERVING WITH ACTORS (ZERO GIL) ---')
	// Python/PyTorch is constrained by CPython's Global Interpreter Lock (GIL).
	// Vex Actors run on native OS threads via Chase-Lev lock-free work stealing.
	mut s1 := ModelServer{ server_id: 1, batches_served: 0 }
	mut s2 := ModelServer{ server_id: 2, batches_served: 0 }
	mut s3 := ModelServer{ server_id: 3, batches_served: 0 }
	mut s4 := ModelServer{ server_id: 4, batches_served: 0 }

	// Non-blocking asynchronous dispatch (<-) fans out across all CPU cores
	fut1 := s1 <- forward_pass(0.5f32)
	fut2 := s2 <- forward_pass(1.0f32)
	fut3 := s3 <- forward_pass(1.5f32)
	fut4 := s4 <- forward_pass(2.0f32)

	// Synchronize results via .await()
	res1 := fut1.await() or { 0.0 }
	res2 := fut2.await() or { 0.0 }
	res3 := fut3.await() or { 0.0 }
	res4 := fut4.await() or { 0.0 }

	println('Multicore Actor Inference Results:')
	println('  Server 1 Result: ${res1}')
	println('  Server 2 Result: ${res2}')
	println('  Server 3 Result: ${res3}')
	println('  Server 4 Result: ${res4}')

	println('=================================================================')
	println('   END OF AI TENSOR DEEP DIVE (Review Telemetry Below)           ')
	println('=================================================================')
}
