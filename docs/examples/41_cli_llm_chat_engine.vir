module main

import os
import io
import flag
import strings

// ============================================================================
// 1. PURE-VIRA GGUF v2/v3 BINARY HEADER, METADATA & VOCABULARY PARSER
// ============================================================================

pub struct GgufMeta {
pub mut:
	version      int
	tensor_count int
	kv_count     int
	arch         string
	model_name   string
	embed_dim    int
	vocab_size   int
	vocab        []string
}

fn read_u32_le(data []u8, pos int) int {
	b0 := int(data[pos])
	b1 := int(data[pos + 1])
	b2 := int(data[pos + 2])
	b3 := int(data[pos + 3])
	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn read_u64_le(data []u8, pos int) int {
	// GGUF counts and string lengths fit in 31-bit signed int for metadata parsing
	return read_u32_le(data, pos)
}

fn skip_gguf_val(data []u8, pos int, vtype int) int {
	if vtype == 0 || vtype == 1 || vtype == 7 {
		return pos + 1
	}
	if vtype == 2 || vtype == 3 {
		return pos + 2
	}
	if vtype == 4 || vtype == 5 || vtype == 6 {
		return pos + 4
	}
	if vtype == 10 || vtype == 11 || vtype == 12 {
		return pos + 8
	}
	if vtype == 8 {
		slen := read_u64_le(data, pos)
		return pos + 8 + slen
	}
	return pos
}

pub fn load_gguf_metadata_and_vocab(path string) !GgufMeta {
	raw := os.read_bytes(path) or {
		return error('failed to read GGUF file ${path}: ${err}')
	}
	if raw.len < 24 {
		return error('GGUF file too small: ${raw.len} bytes')
	}

	magic := read_u32_le(raw, 0)
	if magic != 0x46554747 {
		return error('invalid GGUF magic header')
	}

	version := read_u32_le(raw, 4)
	tensor_count := read_u64_le(raw, 8)
	kv_count := read_u64_le(raw, 16)

	mut pos := 24
	mut arch := 'llama'
	mut model_name := 'unknown'
	mut embed_dim := 64
	mut vocab_size := 32
	mut vocab := []string{}

	mut k := 0
	for k < kv_count {
		klen := read_u64_le(raw, pos)
		pos += 8
		key_bytes := raw.slice(pos, pos + klen)
		key := key_bytes.to_string()
		pos += klen

		vtype := read_u32_le(raw, pos)
		pos += 4

		if key == 'general.architecture' && vtype == 8 {
			slen := read_u64_le(raw, pos)
			pos += 8
			val_bytes := raw.slice(pos, pos + slen)
			arch = val_bytes.to_string()
			pos += slen
		} else if key == 'general.name' && vtype == 8 {
			slen := read_u64_le(raw, pos)
			pos += 8
			val_bytes := raw.slice(pos, pos + slen)
			model_name = val_bytes.to_string()
			pos += slen
		} else if key == 'llama.embedding_length' && vtype == 4 {
			embed_dim = read_u32_le(raw, pos)
			pos += 4
		} else if key == 'llama.vocab_size' && vtype == 4 {
			vocab_size = read_u32_le(raw, pos)
			pos += 4
		} else if key == 'tokenizer.ggml.tokens' && vtype == 9 {
			elem_type := read_u32_le(raw, pos)
			pos += 4
			elem_count := read_u64_le(raw, pos)
			pos += 8
			mut idx := 0
			for idx < elem_count {
				if elem_type == 8 {
					tlen := read_u64_le(raw, pos)
					pos += 8
					tok_bytes := raw.slice(pos, pos + tlen)
					vocab.push(tok_bytes.to_string())
					pos += tlen
				} else {
					pos = skip_gguf_val(raw, pos, elem_type)
				}
				idx += 1
			}
		} else if vtype == 9 {
			elem_type := read_u32_le(raw, pos)
			pos += 4
			elem_count := read_u64_le(raw, pos)
			pos += 8
			mut idx := 0
			for idx < elem_count {
				pos = skip_gguf_val(raw, pos, elem_type)
				idx += 1
			}
		} else {
			pos = skip_gguf_val(raw, pos, vtype)
		}
		k += 1
	}

	return GgufMeta{
		version:      version,
		tensor_count: tensor_count,
		kv_count:     kv_count,
		arch:         arch,
		model_name:   model_name,
		embed_dim:    embed_dim,
		vocab_size:   vocab_size,
		vocab:        vocab,
	}
}

// ============================================================================
// 2. PURE-VIRA WORD / SUBWORD TOKENIZER & DETOKENIZER
// ============================================================================

pub fn tokenize_prompt(prompt string, vocab []string) []int {
	mut tokens := []int{}
	// Prepend <user> role control token (id = 2)
	tokens.push(2)

	trimmed_prompt := prompt.trim()
	lower := trimmed_prompt.to_lower()
	c1 := lower.replace('?', '')
	c2 := c1.replace('!', '')
	c3 := c2.replace('.', '')
	cleaned := c3.replace(',', '')
	words := strings.fields(cleaned)

	for w in words {
		mut matched_id := -1
		mut v_idx := 4
		for v_idx < vocab.len {
			if vocab[v_idx] == w {
				matched_id = v_idx
				break
			}
			v_idx += 1
		}
		if matched_id >= 0 {
			tokens.push(matched_id)
		}
	}

	// If no domain keyword matched directly, fallback to general Vira query token (id = 6)
	if tokens.len == 1 {
		tokens.push(6)
	}

	// Append <assistant> role trigger token (id = 3)
	tokens.push(3)
	return tokens
}

// ============================================================================
// 3. STATEFUL KV-CACHE TRANSFORMER FORWARD ENGINE (PURE VIRA + SIMD)
// ============================================================================

fn apply_logit_constraints(logits tensor[f32], generated []int, vocab_size int, penalty f32) {
	// Mask control tokens (<pad>=0, <user>=2, <assistant>=3) from generation output
	logits.set(0, 0, -1000.0)
	logits.set(0, 2, -1000.0)
	logits.set(0, 3, -1000.0)

	// Apply repetition penalty to tokens already emitted in this response turn
	for prev_id in generated {
		if prev_id >= 0 && prev_id < vocab_size {
			cur_val := logits.get(0, prev_id)
			if cur_val > 0.0 {
				logits.set(0, prev_id, cur_val / penalty)
			} else {
				logits.set(0, prev_id, cur_val * penalty)
			}
		}
	}
}

fn generate_chat_turn(
	prompt string,
	vocab []string,
	token_emb tensor[f32],
	attn_norm tensor[f32],
	wq tensor[f32],
	wk tensor[f32],
	wv tensor[f32],
	wo tensor[f32],
	ffn_norm tensor[f32],
	w_gate tensor[f32],
	w_up tensor[f32],
	w_down tensor[f32],
	out_norm tensor[f32],
	lm_head tensor[f32],
	k_cache tensor[f32],
	v_cache tensor[f32],
	max_tokens int,
	temperature f32
) int {
	t_start_us := time_now_us()
	prompt_tokens := tokenize_prompt(prompt, vocab)
	mut pos := 0

	// Phase A: Prefill Prompt Tokens into KV Cache (0 .. prompt_tokens.len - 2)
	mut p_idx := 0
	for p_idx < prompt_tokens.len - 1 {
		tok_id := prompt_tokens.get(p_idx) or { 2 }
		arena {
			h_embed := tensor_embedding(token_emb, tok_id)
			h1 := tensor_rmsnorm(h_embed, attn_norm, 0.00001)
			q_proj := h1 @ wq
			k_proj := h1 @ wk
			q := tensor_rope(q_proj, pos, 10000.0)
			k := tensor_rope(k_proj, pos, 10000.0)
			v := h1 @ wv
			_ := q

			// Write K and V into stateful KV cache row `pos`
			k_cache.copy_row(pos, k)
			v_cache.copy_row(pos, v)
		}
		pos += 1
		p_idx += 1
	}

	// Phase B: Autoregressive Generation starting from <assistant> trigger token (id = 3)
	mut cur_token := prompt_tokens.get(prompt_tokens.len - 1) or { 3 }
	mut generated_ids := []int{}
	mut gen_steps := 0

	print('ViraChat > ')
	for gen_steps < max_tokens {
		mut next_tok := 1
		arena {
			// 1. Token Embedding Lookup
			h_embed := tensor_embedding(token_emb, cur_token)

			// 2. RMSNorm + Q, K, V Projections + RoPE Positional Encoding
			h1 := tensor_rmsnorm(h_embed, attn_norm, 0.00001)
			q_proj := h1 @ wq
			k_proj := h1 @ wk
			q := tensor_rope(q_proj, pos, 10000.0)
			k := tensor_rope(k_proj, pos, 10000.0)
			v := h1 @ wv

			// 3. Append current step K, V to KV Cache & Slice Active Context [0 .. pos + 1]
			k_cache.copy_row(pos, k)
			v_cache.copy_row(pos, v)
			k_active := k_cache.slice_rows(0, pos + 1)
			v_active := v_cache.slice_rows(0, pos + 1)

			// 4. Causal Multi-Token Attention over full prompt + generated history
			k_t := k_active.transpose()
			qk := q @ k_t
			scores := tensor_scale(qk, 0.125)
			attn_probs := tensor_softmax(scores)
			av := attn_probs @ v_active
			attn_out := av @ wo
			h_attn := h_embed + attn_out

			// 5. SwiGLU Feed-Forward Network Block
			h2 := tensor_rmsnorm(h_attn, ffn_norm, 0.00001)
			gate_proj := h2 @ w_gate
			gate := tensor_silu(gate_proj)
			up := h2 @ w_up
			ffn_mid := tensor_elemwise_mul(gate, up)
			ffn_out := ffn_mid @ w_down
			h_ffn := h_attn + ffn_out

			// 6. Final RMSNorm & LM Head Logits
			h_final := tensor_rmsnorm(h_ffn, out_norm, 0.00001)
			logits := h_final @ lm_head

			// 7. Repetition Penalty & Temperature Token Sampling
			apply_logit_constraints(logits, generated_ids, vocab.len, 1.3)
			next_tok = sample_token(logits, temperature)
		}

		// Stop on <eos> token (id = 1)
		if next_tok == 1 {
			break
		}

		if next_tok >= 0 && next_tok < vocab.len {
			print(vocab[next_tok])
		} else {
			print('<unk>')
		}

		generated_ids.push(next_tok)
		cur_token = next_tok
		pos += 1
		gen_steps += 1
	}
	println('')

	elapsed_us := time_now_us() - t_start_us
	mut safe_us := elapsed_us
	if safe_us <= 0 {
		safe_us = 1
	}
	total_toks := prompt_tokens.len + gen_steps
	println('           [kv_tokens=${pos + 1} | generated=${gen_steps} | latency=${safe_us} us]')
	return total_toks
}

// ============================================================================
// 4. CLI ENTRYPOINT: FLAGS, SCRIPTED DEMO & INTERACTIVE REPL
// ============================================================================

fn print_repl_help() {
	println('Available REPL Slash Commands:')
	println('  /help          Show this help message')
	println('  /stats         Display model metadata and session token statistics')
	println('  /clear         Reset session token counter')
	println('  /exit, /quit   Exit the interactive chat REPL')
}

fn main() {
	mut fs := flag.FlagSet.new('vira-chat')
	fs.string_flag('model', 'm', 'models/vira_chat.gguf', 'Path to GGUF v2/v3 model file')
	fs.f64_flag('temp', 't', 0.0, 'Sampling temperature (0.0 = greedy argmax)')
	fs.int_flag('max-tokens', 'n', 16, 'Maximum tokens to generate per turn')
	fs.string_flag('prompt', 'p', '', 'Single-shot prompt to execute and exit')
	fs.bool_flag('interactive', 'i', false, 'Launch interactive CLI chat REPL')

	raw_args := os.args()
	mut cli_args := []string{}
	if raw_args.len > 1 {
		cli_args = raw_args.slice(1, raw_args.len)
	}
	_ := fs.parse(cli_args) or {
		eprintln('Flag error: ${err}')
		return
	}

	model_path := fs.get_string('model')
	temp := f32(fs.get_f64('temp'))
	max_tokens := fs.get_int('max-tokens')
	single_prompt := fs.get_string('prompt')
	is_interactive := fs.get_bool('interactive')

	println('=== 1. PURE-VIRA GGUF v3 MODEL & VOCABULARY INGESTION ===')
	meta := load_gguf_metadata_and_vocab(model_path) or {
		eprintln('Failed to parse GGUF header: ${err}')
		return
	}
	println('Model Name      : ${meta.model_name} (GGUF v${meta.version})')
	println('Architecture    : ${meta.arch} (hidden_dim=${meta.embed_dim}, vocab_size=${meta.vocab_size})')
	println('Tensors / Vocab : ${meta.tensor_count} tensors | ${meta.vocab.len} embedded tokens loaded')

	// Load all 12 LLaMA Transformer tensors into 64-byte aligned SIMD buffers
	token_emb := gguf_load_tensor(model_path, 'token_embd.weight') or { return }
	attn_norm := gguf_load_tensor(model_path, 'blk.0.attn_norm.weight') or { return }
	wq := gguf_load_tensor(model_path, 'blk.0.attn_q.weight') or { return }
	wk := gguf_load_tensor(model_path, 'blk.0.attn_k.weight') or { return }
	wv := gguf_load_tensor(model_path, 'blk.0.attn_v.weight') or { return }
	wo := gguf_load_tensor(model_path, 'blk.0.attn_output.weight') or { return }
	ffn_norm := gguf_load_tensor(model_path, 'blk.0.ffn_norm.weight') or { return }
	w_gate := gguf_load_tensor(model_path, 'blk.0.ffn_gate.weight') or { return }
	w_up := gguf_load_tensor(model_path, 'blk.0.ffn_up.weight') or { return }
	w_down := gguf_load_tensor(model_path, 'blk.0.ffn_down.weight') or { return }
	out_norm := gguf_load_tensor(model_path, 'output_norm.weight') or { return }
	lm_head := gguf_load_tensor(model_path, 'output.weight') or { return }

	// Preallocate stateful KV-Cache tensors (MaxSeq = 64, HiddenDim = 64)
	k_cache := tensor_fill(64, meta.embed_dim, 0.0)
	v_cache := tensor_fill(64, meta.embed_dim, 0.0)

	// Mode 1: Single-shot CLI prompt (--prompt "...")
	if single_prompt.len > 0 {
		println('=== 2. SINGLE-SHOT CLI PROMPT EXECUTION ===')
		println('You      > ${single_prompt}')
		_ := generate_chat_turn(
			single_prompt, meta.vocab,
			token_emb, attn_norm, wq, wk, wv, wo,
			ffn_norm, w_gate, w_up, w_down, out_norm, lm_head,
			k_cache, v_cache, max_tokens, temp
		)
		return
	}

	// Mode 2: Interactive Terminal Chat REPL (--interactive / -i)
	if is_interactive {
		println('=== 2. INTERACTIVE PURE-VIRA LLM CLI CHAT REPL ===')
		println('Type a message or /help for commands. Type /exit to quit.')
		mut total_session_tokens := 0
		mut turns := 0
		for {
			line := io.prompt('You      > ') or {
				break
			}
			trimmed := line.trim()
			if trimmed.len == 0 {
				continue
			}
			if trimmed == '/exit' || trimmed == '/quit' {
				println('Exiting ViraChat CLI. Goodbye!')
				break
			}
			if trimmed == '/help' {
				print_repl_help()
				continue
			}
			if trimmed == '/clear' {
				total_session_tokens = 0
				turns = 0
				println('[ViraChat] Conversation state cleared.')
				continue
			}
			if trimmed == '/stats' {
				println('[ViraChat Stats] Turns: ${turns} | Total Tokens Processed: ${total_session_tokens}')
				continue
			}

			toks := generate_chat_turn(
				trimmed, meta.vocab,
				token_emb, attn_norm, wq, wk, wv, wo,
				ffn_norm, w_gate, w_up, w_down, out_norm, lm_head,
				k_cache, v_cache, max_tokens, temp
			)
			total_session_tokens += toks
			turns += 1
		}
		return
	}

	// Mode 3: Default Multi-Turn Conversational Verification Suite
	println('=== 2. MULTI-TURN KV-CACHED CONVERSATIONAL CLI SESSION ===')
	prompts := [
		'Hello there!',
		'What is the Vira compiler?',
		'How does memory and arena management work?',
		'Explain Vira actors and threads'
	]

	mut total_tokens := 0
	for p in prompts {
		println('You      > ${p}')
		t := generate_chat_turn(
			p, meta.vocab,
			token_emb, attn_norm, wq, wk, wv, wo,
			ffn_norm, w_gate, w_up, w_down, out_norm, lm_head,
			k_cache, v_cache, max_tokens, temp
		)
		total_tokens += t
	}

	println('=== 3. SESSION SUMMARY ===')
	println('Completed ${prompts.len} conversational turns (${total_tokens} total tokens) in 100% Pure Vira.')
}
