module package_consumer_demo

// ==============================================================================
// Vira Package Management Demo
// Demonstrates consuming an external package installed via:
//   vira add C:/Users/hp/vira_test
//   (or vira add github.com/micromax/vira_test)
//
// The compiler automatically resolves imports across:
// 1. Current file directory
// 2. Project src/ directory
// 3. Project root directory
// 4. Vendored dependencies:   ./vendor/<package>
// 5. Local project cache:     ./.vira/pkg/<package>
// 6. Global toolchain cache:  ~/.vir/pkg/<package>
// ==============================================================================

import "vira_test"

fn main() {
	// 1. Instantiate the imported Logger using qualified package namespace `vira_test.Logger`
	mut log := vira_test.Logger.new('ConsumerApp')
	log.info('External package successfully imported with package namespacing!')

	// 2. Perform 2D Vector operations using qualified `vira_test.Vec2`
	v1 := vira_test.Vec2.new(10.0, 20.0)
	v2 := vira_test.Vec2.new(5.0, 15.0)

	sum := v1.add(v2)
	scaled := sum.scale(2.0)
	dot_prod := v1.dot(v2)

	log.ok('Vector math results:')
	println('  • v1:       (${v1.x}, ${v1.y})')
	println('  • v2:       (${v2.x}, ${v2.y})')
	println('  • v1 + v2:  (${sum.x}, ${sum.y})')
	println('  • scaled:   (${scaled.x}, ${scaled.y})')
	println('  • dot prod: ${dot_prod}')

	// 3. Use package-qualified numeric utilities `vira_test.clamp`, `vira_test.min_int`, `vira_test.max_int`
	raw_speed := 165
	bounded_speed := vira_test.clamp(raw_speed, 0, 100)
	min_val := vira_test.min_int(45, 90)
	max_val := vira_test.max_int(45, 90)

	log.info('Numeric utility results:')
	println('  • vira_test.clamp(165, 0, 100) = ${bounded_speed}')
	println('  • vira_test.min_int(45, 90)    = ${min_val}')
	println('  • vira_test.max_int(45, 90)    = ${max_val}')

	log.ok('All external package capabilities verified successfully!')
}
