module enterprise_app

// Vira Scopes & Multi-Package Architecture Demonstration
// Demonstrates:
// 1. 4-Quadrant Struct Encapsulation (default, mut:, pub:, pub mut:)
// 2. Lexical & Function Scopes with deterministic Autofree destructors
// 3. Isolated Actor Concurrency Scope without shared mutable memory
// 4. Clean domain modeling with static factory methods (e.g. ClusterNode.new)

pub struct AppConfig {
	secret_salt string
mut:
	reload_count int
pub:
	app_name string
	environment string
	max_workers int
pub mut:
	debug_mode bool
}

pub fn AppConfig.new(app_name string, env string, workers int) AppConfig {
	return AppConfig{
		secret_salt: 'sec_vault_k98',
		reload_count: 0,
		app_name: app_name,
		environment: env,
		max_workers: workers,
		debug_mode: true
	}
}

pub fn (mut c AppConfig) bump_reload() {
	c.reload_count += 1
}

pub struct ClusterNode {
pub:
	id int
	hostname string
	cores int
mut:
	assigned_tasks int
	is_online bool
}

pub fn ClusterNode.new(id int, hostname string, cores int) ClusterNode {
	return ClusterNode{
		id: id,
		hostname: hostname,
		cores: cores,
		assigned_tasks: 0,
		is_online: true
	}
}

pub fn (mut c ClusterNode) assign_job() {
	c.assigned_tasks += 1
}

pub actor WorkerActor {
pub:
	worker_id int
mut:
	jobs_processed int
}

pub fn WorkerActor.new(id int) WorkerActor {
	return WorkerActor{
		worker_id: id,
		jobs_processed: 0
	}
}

pub fn (mut w WorkerActor) execute_workload(scale f32) f32 {
	w.jobs_processed += 1
	weights := tensor_fill(32, 32, 0.5)
	inputs := tensor_fill(32, 32, scale)
	out := weights @ inputs
	return tensor_sum(out)
}

fn main() {
	// 1. Configuration Package Scope
	mut cfg := AppConfig.new('Vira-Enterprise-Cluster', 'production', 8)
	println('=== ${cfg.app_name} [env=${cfg.environment}] ===')
	println('Worker Thread Pool: ${cfg.max_workers} cores | Debug: ${cfg.debug_mode}')

	// 2. Domain Model Scope
	mut node1 := ClusterNode.new(101, 'node-us-east-1a', 16)
	mut node2 := ClusterNode.new(102, 'node-us-east-1b', 32)
	node1.assign_job()
	node2.assign_job()

	println('--- Registered Cluster Nodes ---')
	println('Node #${node1.id}: ${node1.hostname} (${node1.cores} cores, tasks=${node1.assigned_tasks})')
	println('Node #${node2.id}: ${node2.hostname} (${node2.cores} cores, tasks=${node2.assigned_tasks})')

	// 3. Isolated Actor Concurrency Scope
	println('--- Asynchronous Multi-Core Actor Dispatch ---')
	mut worker1 := WorkerActor.new(1)
	mut worker2 := WorkerActor.new(2)

	fut1 := worker1 <- execute_workload(1.5)
	fut2 := worker2 <- execute_workload(2.0)

	res1 := fut1.await() or { 0.0 }
	res2 := fut2.await() or { 0.0 }

	println('Worker #1 Tensor Sum: ${res1}')
	println('Worker #2 Tensor Sum: ${res2}')

	cfg.bump_reload()
	println('Multi-package architecture pipeline finished cleanly.')
}
