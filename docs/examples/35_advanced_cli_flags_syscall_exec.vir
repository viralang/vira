// ============================================================================
// VIRA TUTORIAL 32: ADVANCED CLI FLAGS, STRUCTURED LOGGING, SYSCALL & EXEC
// ============================================================================
// Demonstrates:
// 1. Production command-line parsing with `flag.FlagSet`
// 2. Structured, leveled console logging with `log.Logger`
// 3. Child process orchestration with `exec.Command`
// 4. Low-level UNIX/POSIX file descriptor IPC with `syscall.pipe`
// 5. Zero memory leak deterministic execution
//
// Run via:
//   vira run docs/examples/35_advanced_cli_flags_syscall_exec.vir -- --verbose -w 8 --target=cloud task1 task2
// ============================================================================
module main

import os
import flag
import log
import exec
import syscall

fn run_flag_and_logger_demo() {
	println('[1] Command-Line Flag Parsing & Structured Logging:')
	mut fs := flag.FlagSet.new('task_runner')
	fs.bool_flag('verbose', 'v', false, 'Enable verbose debug tracing')
	fs.int_flag('workers', 'w', 4, 'Number of parallel worker routines')
	fs.string_flag('target', 't', 'local', 'Deployment target environment')
	fs.f64_flag('timeout', 's', 30.0, 'Operation timeout in seconds')

	args := os.args()
	// Skip argv[0] (binary path) when passing to FlagSet
	mut cli_args := []string{}
	if args.len > 1 {
		cli_args = args.slice(1, args.len)
	}

	_ := fs.parse(cli_args) or {
		eprintln('Failed to parse command-line arguments: ${err}')
		return
	}

	is_verbose := fs.get_bool('verbose')
	workers := fs.get_int('workers')
	target := fs.get_string('target')
	timeout := fs.get_f64('timeout')

	mut l := log.Logger.new(log.LEVEL_INFO)
	l.set_prefix('runner')
	if is_verbose {
		l.set_level(log.LEVEL_DEBUG)
	}

	l.debug('Debug tracing activated (workers=${workers}, timeout=${timeout}s)')
	l.info('Initializing execution pipeline for target: ${target}')

	positionals := fs.args
	println('  Parsed Flag Values:')
	println('    --verbose : ${is_verbose}')
	println('    --workers : ${workers}')
	println('    --target  : ${target}')
	println('    --timeout : ${timeout}')
	println('  Remaining Positional Arguments (${positionals.len}):')
	for mut i := 0; i < positionals.len; i += 1 {
		println('    pos[${i}] = \'${positionals[i]}\'')
	}
	println('')
}

fn run_exec_demo() {
	println('[2] Child Subprocess Execution (exec.Command):')
	mut cmd := exec.Command.new('echo', ['Vira Child Process Active'])
	if os.is_windows() {
		cmd = exec.Command.new('cmd', ['/c', 'echo Vira Child Process Active'])
	}
	out := cmd.combined_output() or {
		eprintln('Failed to execute command: ${err}')
		return
	}
	println('  Spawned child process: "${cmd.name}"')
	println('  Combined stdout/stderr output: ${out}')
	println('')
}

fn run_syscall_pipe_demo() {
	println('[3] Low-Level Kernel IPC (syscall.pipe):')
	mut fds := []int{}
	syscall.pipe(mut fds) or {
		eprintln('Failed to allocate kernel pipe: ${err}')
		return
	}

	r_fd := fds[0]
	w_fd := fds[1]
	defer syscall.close(r_fd)
	defer syscall.close(w_fd)

	payload := 'VIRA_PIPE_MESSAGE_VERIFIED'
	b_out := payload.bytes()

	w_bytes := syscall.write(w_fd, b_out, b_out.len) or {
		eprintln('Kernel write failed: ${err}')
		return
	}
	println('  Wrote ${w_bytes} bytes into pipe write-end (fd=${w_fd})')

	mut b_in := []u8{}
	r_bytes := syscall.read(r_fd, mut b_in, 128) or {
		eprintln('Kernel read failed: ${err}')
		return
	}
	recv_str := b_in.to_string()
	println('  Read ${r_bytes} bytes from pipe read-end (fd=${r_fd}): "${recv_str}"')
	println('  Direct file descriptor cleanup handled by `defer`.')
	println('')
}

fn main() {
	println('===========================================================')
	println('  Vira Advanced Systems Stack: Flags, Logging, Syscall & Exec')
	println('===========================================================')

	run_flag_and_logger_demo()
	run_exec_demo()
	run_syscall_pipe_demo()

	println('✓ All advanced subsystems verified with 0 leaks.')
}
