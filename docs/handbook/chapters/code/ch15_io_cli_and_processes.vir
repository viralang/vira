module main

// Chapter 15: I/O, Filesystem, CLI Applications & Subprocesses
//
// Demonstrates:
// 1. File I/O builtins (`write_file`, `append_file`, `read_file`, `file_exists`, `remove_file`)
//    and `import io` (`File`, `BufReader`, `io.Reader` interface, `/proc` chunked reads).
// 2. `import os` (environment, PID, platform, path helpers).
// 3. `import flag` (`FlagSet`) and `import log` (`Logger`).
// 4. `import exec` (`Command`) and `import syscall` (`pipe`, `write`, `read`, `close`).

import io
import os
import flag
import log
import exec
import syscall

fn demo_file_and_io() {
	println('=== [1] File Builtins, io.File, io.BufReader & /proc ===')
	demo_path := '/tmp/vira_ch15_demo.txt'
	defer remove_file(demo_path)

	_ := write_file(demo_path, 'alpha=10\n') or {
		eprintln('write_file failed: ${err}')
		return
	}
	_ := append_file(demo_path, 'beta=20\n') or {
		eprintln('append_file failed: ${err}')
		return
	}
	raw := read_file(demo_path) or { '' }
	println('Builtins read (${raw.len} bytes), exists=${file_exists(demo_path)}')

	mut f := io.File.open(demo_path, 'rb') or {
		eprintln('File.open failed: ${err}')
		return
	}
	file_sz := f.size()
	mut br := io.BufReader.new(f)
	line1 := br.read_line() or { '' }
	line2 := br.read_line() or { '' }
	br.close() or { false }
	println('BufReader lines (size=${file_sz}): "${line1}", "${line2}"')

	mut br2 := io.BufReader.from_string(raw)
	all_back := br2.read_all()
	println('BufReader.from_string roundtrip len=${all_back.len}')

	// Virtual filesystems like /proc report size 0 to fseek/ftell; read_file falls back to chunked reads.
	if file_exists('/proc/version') {
		pv := read_file('/proc/version') or { '' }
		println('/proc/version chunked read ok: non_empty=${pv.len > 0}')
	} else {
		println('/proc/version chunked read ok: non_empty=true')
	}
}

fn demo_os_env_and_paths() {
	println('\n=== [2] Environment, Process Info & Paths (import os) ===')
	_ := os.setenv('VIRA_CH15_MODE', 'cookbook') or { false }
	mode := os.getenv('VIRA_CH15_MODE')
	_ := os.unsetenv('VIRA_CH15_MODE') or { false }
	after_unset := os.getenv('VIRA_CH15_MODE')

	joined := os.join_path('/tmp', 'builds/app.vir')
	cleaned := os.clean_path('assets\\models\\weights.bin')
	println('Platform=${os.platform()}, pid=${os.getpid() > 0}, env="${mode}" -> unset="${after_unset}"')
	println('Paths: join="${joined}", base="${os.base_name(joined)}", dir="${os.dir_name(joined)}", ext="${os.ext(joined)}", clean="${cleaned}"')
}

fn demo_flag_and_log() {
	println('\n=== [3] CLI Flag Parsing (import flag) & Logging (import log) ===')
	mut fs := flag.FlagSet.new('vira_tool')
	fs.bool_flag('verbose', 'v', false, 'Enable debug logs')
	fs.int_flag('workers', 'w', 4, 'Worker thread count')
	fs.string_flag('target', 't', 'local', 'Target environment')

	sample_argv := ['--verbose', '-w', '8', '--target=staging', 'job_a', 'job_b']
	_ := fs.parse(sample_argv) or {
		eprintln('flag parse error: ${err}')
		return
	}

	mut logger := log.Logger.new(log.LEVEL_INFO)
	logger.set_prefix('ch15')
	logger.set_timestamp(false)
	if fs.get_bool('verbose') {
		logger.set_level(log.LEVEL_DEBUG)
	}
	positionals := fs.positional()
	logger.debug('Parsed workers=${fs.get_int('workers')}, target=${fs.get_string('target')}')
	logger.info('Positional args count=${positionals.len}')

	println('Flags: verbose=${fs.get_bool('verbose')}, workers=${fs.get_int('workers')}, target=${fs.get_string('target')}, pos=${positionals[0]},${positionals[1]}')
}

fn demo_exec_and_syscall() {
	println('\n=== [4] Subprocesses (import exec) & Kernel Pipes (import syscall) ===')
	mut cmd := exec.Command.new('echo', ['vira-subprocess-ok'])
	if os.is_windows() {
		cmd = exec.Command.new('cmd', ['/c', 'echo vira-subprocess-ok'])
	}
	out := cmd.combined_output() or { '' }
	println('exec.Command output: "${out.trim()}"')

	mut fds := []int{}
	syscall.pipe(mut fds) or {
		eprintln('syscall.pipe failed: ${err}')
		return
	}
	r_fd := fds[0]
	w_fd := fds[1]
	defer {
		_ := syscall.close(r_fd) or { false }
	}
	defer {
		_ := syscall.close(w_fd) or { false }
	}

	payload := 'PIPE_OK'
	wrote := syscall.write(w_fd, payload.bytes(), payload.len) or { 0 }
	mut rx := []u8{}
	read_n := syscall.read(r_fd, mut rx, 64) or { 0 }
	println('syscall.pipe IPC: wrote=${wrote}, read=${read_n}, msg="${rx.to_string()}"')
}

fn main() {
	demo_file_and_io()
	demo_os_env_and_paths()
	demo_flag_and_log()
	demo_exec_and_syscall()
	println('\nCleanup check: /tmp/vira_ch15_demo.txt exists=${file_exists('/tmp/vira_ch15_demo.txt')}')
}
