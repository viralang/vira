module main

import math

fn test_trig_and_hypot() {
	if math.PI < 3.14 || math.PI > 3.15 {
		panic('invalid PI constant')
	}
	hyp := math.hypot(3.0, 4.0)
	if hyp < 4.9999 || hyp > 5.0001 {
		panic('hypot(3, 4) must be 5')
	}
	println('✓ test_trig_and_hypot passed')
}

fn test_clamp_and_sqrt() {
	clamped := math.clamp(15.0, 0.0, 10.0)
	if clamped != 10.0 {
		panic('clamp failed')
	}
	root := math.sqrt(81.0)
	if root < 8.9999 || root > 9.0001 {
		panic('sqrt(81) must be 9')
	}
	println('✓ test_clamp_and_sqrt passed')
}

fn test_sorting_slices() {
	mut nums := [9, 2, 7, 1, 5]
	math.sort_ints(mut nums)
	if nums[0] != 1 || nums[2] != 5 || nums[4] != 9 {
		panic('sort_ints failed')
	}

	mut fnums := [4.4, 1.1, 3.3]
	math.sort_f64s(mut fnums)
	if fnums[0] != 1.1 || fnums[1] != 3.3 || fnums[2] != 4.4 {
		panic('sort_f64s failed')
	}
	println('✓ test_sorting_slices passed')
}
