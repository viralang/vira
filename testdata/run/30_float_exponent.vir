// OUT: true 100000.00 2.50 100050.00 300.00 7 true
// OUT: [vira_rt] active_leaks=0

// T-087: float literals with an exponent.
struct P {
pub mut:
    e int
}

fn main() {
    a := f32(-1.0e31)
    b := 1e5
    c := 2.5E-3 * 1000.0
    d := 1_000.5e+2
    e := 3e2f32
    f := f32(1e-12)
    p := P{ e: 7 }
    println('${a < f32(-1.0e30)} ${b} ${c} ${d} ${e} ${p.e} ${f > f32(0.0)}')
}

