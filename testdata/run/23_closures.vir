// OUT: triple 15 apply 21 double 42
// OUT: add10 15 direct 2
// OUT: Hello, Ada!
// OUT: compose 10
// OUT: Hello, Grace!
// OUT: pipeline 11
// OUT: ok: clicked 2 times
// OUT: item-7
// OUT: [vira_rt] active_leaks=0 | total_freed=20

// Closures: fn (A) R types, anonymous functions capturing by value, closures returned
// from functions, composed, stored in slices, maps and struct fields, named functions as
// values, and calling a freshly made closure. No leaks.
module main

struct Button {
	label string
	on_click fn (int) string
}

fn apply(f fn (int) int, x int) int {
	return f(x)
}

fn double(x int) int {
	return x * 2
}

fn make_adder(n int) fn (int) int {
	return fn (x int) int {
		return x + n
	}
}

fn make_greeter(greeting string) fn (string) string {
	return fn (name string) string {
		return '${greeting}, ${name}!'
	}
}

fn compose(f fn (int) int, g fn (int) int) fn (int) int {
	return fn (x int) int {
		return g(f(x))
	}
}

fn main() {
	k := 3
	triple := fn (x int) int {
		return x * k
	}
	println('triple ${triple(5)} apply ${apply(triple, 7)} double ${apply(double, 21)}')
	add10 := make_adder(10)
	println('add10 ${add10(5)} direct ${make_adder(1)(1)}')
	hi := make_greeter('Hello')
	println(hi('Ada'))
	inc_then_double := compose(make_adder(1), double)
	println('compose ${inc_then_double(4)}')
	copy := hi
	println(copy('Grace'))
	mut fs := []fn (int) int{}
	fs.push(double)
	fs.push(add10)
	fs.push(fn (x int) int { return x - 1 })
	mut acc := 1
	for f in fs {
		acc = f(acc)
	}
	println('pipeline ${acc}')
	b := Button{ label: 'ok', on_click: fn (n int) string { return 'clicked ${n} times' } }
	println('${b.label}: ${b.on_click(2)}')
	prefix := 'item'
	label := fn (i int) string {
		return '${prefix}-${i}'
	}
	mut names := map[int]fn (int) string{}
	names[1] = label
	println(names[1](7))
	apply(fn (x int) int { return x }, 1)
}
