module main

import syscall

fn test_constants_and_pids() {
	pid := syscall.getpid()
	if pid <= 0 {
		panic("invalid pid")
	}

	if syscall.CLONE_NEWPID != 0x20000000 {
		panic("CLONE_NEWPID mismatch")
	}
	if syscall.MNT_DETACH != 2 {
		panic("MNT_DETACH mismatch")
	}
	if syscall.O_RDWR != 2 {
		panic("O_RDWR mismatch")
	}

	dev := syscall.makedev(1, 3)
	if dev <= 0 {
		panic("invalid makedev result")
	}
	println("✓ test_constants_and_pids passed")
}

fn test_pipe_and_io() {
	mut fds := []int{}
	syscall.pipe(mut fds) or {
		panic("pipe failed: ${err}")
	}
	if fds.len != 2 {
		panic("expected 2 fds from pipe")
	}

	r_fd := fds[0]
	w_fd := fds[1]

	msg := "Hello Syscall"
	b := msg.bytes()
	w_n := syscall.write(w_fd, b, b.len) or {
		panic("write failed: ${err}")
	}
	if w_n != b.len {
		panic("partial write")
	}

	mut read_buf := []u8{}
	r_n := syscall.read(r_fd, mut read_buf, 64) or {
		panic("read failed: ${err}")
	}
	if r_n != b.len {
		panic("partial read")
	}

	res_str := read_buf.to_string()
	if res_str != "Hello Syscall" {
		panic("pipe data mismatch: ${res_str}")
	}

	syscall.close(r_fd) or { panic("close r_fd failed") }
	syscall.close(w_fd) or { panic("close w_fd failed") }
	println("✓ test_pipe_and_io passed")
}

fn main() {
	test_constants_and_pids()
	test_pipe_and_io()
	println("All syscall tests passed successfully!")
}
