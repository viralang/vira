module main

import "viraserve"
import net
import http

fn main() {
	println('=== 1. TESTING REQUEST & JSON PARSING ===')
	req := viraserve.Request.new('POST', '/test', '', '{"name":"vira_test","count":42,"rate":3.14}', 1)
	if !req.is_post() {
		panic('expected is_post to be true')
	}
	name := req.json_str('name')
	if name != 'vira_test' {
		panic('expected name to be vira_test')
	}
	count := req.json_int('count')
	if count != 42 {
		panic('expected count to be 42')
	}
	println('✓ Request & JSON field extraction passed')

	println('=== 2. TESTING ROUTER MATCHING ===')
	router := viraserve.Router.new('test_router', 'v1')
	if router.match_route('GET', '/') != viraserve.RouteID.home() {
		panic('expected RouteID.home')
	}
	if router.match_route('GET', '/health') != viraserve.RouteID.health() {
		panic('expected RouteID.health')
	}
	if router.match_route('POST', '/api/v1/predict') != viraserve.RouteID.predict() {
		panic('expected RouteID.predict')
	}
	if router.match_route('GET', '/invalid') != viraserve.RouteID.not_found() {
		panic('expected RouteID.not_found')
	}
	println('✓ Router route matching passed')

	println('=== 3. TESTING RESPONSE BUILDER ===')
	mut res := viraserve.Response.new()
	res.json('{"test":"ok"}')
	if res.status_code != 200 {
		panic('expected status 200')
	}
	res.not_found('item missing')
	if res.status_code != 404 {
		panic('expected status 404')
	}
	println('✓ Response builder & error formatting passed')

	println('=== 4. TESTING FULL SERVER DISPATCH PIPELINE ===')
	mut server := viraserve.ViraServe.new('TestServer', 9000)
	test_req := viraserve.Request.new('GET', '/health', '', '', 2)
	test_res := server.dispatch_request(test_req)
	if test_res.status_code != 200 {
		panic('expected 200 status from /health')
	}
	println('✓ Full server request dispatch passed')

	println('=== 5. TESTING LIVE HTTP SERVER DISPATCH ===')
	mut http_srv := http.HttpServer.bind('127.0.0.1:0') or {
		panic('failed to bind http server: ${err}')
	}
	addr := http_srv.local_addr() or {
		panic('failed to get local addr: ${err}')
	}
	mut client := net.TcpStream.connect('${addr.ip}:${addr.port}') or {
		panic('failed to connect client: ${err}')
	}
	client.write_str('GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n') or {
		panic('failed to write request: ${err}')
	}
	ok := server.serve_one(mut http_srv) or {
		panic('failed to serve request: ${err}')
	}
	if !ok {
		panic('expected serve_one to succeed')
	}
	resp := client.read_string(1024) or {
		panic('failed to read response: ${err}')
	}
	if resp.len <= 0 {
		panic('expected response data')
	}
	client.close() or { false }
	http_srv.close() or { false }
	println('✓ Live HTTP server dispatch passed')

	println('ALL VIRASERVE UNIT TESTS PASSED!')
}
