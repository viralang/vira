module viraserve

// --- HTTP REQUEST ABSTRACTION ---
pub struct Request {
pub:
	method string
	path string
	query string
	raw_body string
	client_fd int
}

pub fn Request.new(method string, path string, query string, raw_body string, client_fd int) Request {
	return Request{
		method: method,
		path: path,
		query: query,
		raw_body: raw_body,
		client_fd: client_fd
	}
}

pub fn (r Request) is_get() bool {
	return r.method == 'GET'
}

pub fn (r Request) is_post() bool {
	return r.method == 'POST'
}

pub fn (r Request) is_put() bool {
	return r.method == 'PUT'
}

pub fn (r Request) is_delete() bool {
	return r.method == 'DELETE'
}

// JSON Payload extraction helper methods
pub fn (r Request) json_str(key string) string {
	if r.raw_body == '' {
		return ''
	}
	return json_get_str(r.raw_body, key)
}

pub fn (r Request) json_int(key string) i64 {
	if r.raw_body == '' {
		return 0
	}
	return json_get_int(r.raw_body, key)
}

pub fn (r Request) json_f32(key string) f32 {
	if r.raw_body == '' {
		return 0.0
	}
	return json_get_f32(r.raw_body, key)
}

// --- HTTP RESPONSE ABSTRACTION ---
pub struct Response {
pub mut:
	status_code int
	content_type string
	body string
}

pub fn Response.new() Response {
	return Response{
		status_code: 200,
		content_type: 'application/json',
		body: '{"status":"ok"}'
	}
}

pub fn (mut res Response) status(code int) {
	res.status_code = code
}

pub fn (mut res Response) json(body_json string) {
	res.status_code = 200
	res.content_type = 'application/json'
	res.body = body_json
}

pub fn (mut res Response) text(body_text string) {
	res.status_code = 200
	res.content_type = 'text/plain'
	res.body = body_text
}

pub fn (mut res Response) html(body_html string) {
	res.status_code = 200
	res.content_type = 'text/html'
	res.body = body_html
}

pub fn (mut res Response) not_found(msg string) {
	res.status_code = 404
	res.content_type = 'application/json'
	res.body = '{"error":"not_found","message":"${msg}","code":404}'
}

pub fn (mut res Response) bad_request(msg string) {
	res.status_code = 400
	res.content_type = 'application/json'
	res.body = '{"error":"bad_request","message":"${msg}","code":400}'
}

pub fn (mut res Response) internal_error(msg string) {
	res.status_code = 500
	res.content_type = 'application/json'
	res.body = '{"error":"internal_server_error","message":"${msg}","code":500}'
}

pub fn (res Response) serialize() string {
	return http_response(res.status_code, res.content_type, res.body)
}
