module viraserve

// --- TELEMETRY & SERVER STATS ---
pub struct ServerStats {
pub mut:
	total_requests int = 0
	total_errors int = 0
	total_latency_us i64 = 0
}

pub fn ServerStats.new() ServerStats {
	return ServerStats{
		total_requests: 0,
		total_errors: 0,
		total_latency_us: 0
	}
}

pub fn (mut s ServerStats) record(status_code int, latency_us i64) {
	s.total_requests = s.total_requests + 1
	s.total_latency_us = s.total_latency_us + latency_us
	if status_code >= 400 {
		s.total_errors = s.total_errors + 1
	}
}

pub fn (s ServerStats) avg_latency_us() i64 {
	if s.total_requests == 0 {
		return 0
	}
	return s.total_latency_us / s.total_requests
}

// --- LOGGING & ACCESS TRACE MIDDLEWARE ---
pub fn log_access(method string, path string, status_code int, latency_us i64) {
	mut status_tag := 'ERROR'
	if status_code == 200 {
		status_tag = 'OK'
	} else if status_code == 404 {
		status_tag = 'NOT_FOUND'
	}
	println('[viraserve] ${method} ${path} -> ${status_code} ${status_tag} (${latency_us} µs)')
}
