module net

@[intrinsic: 'vira_net_udp_bind']
fn c_udp_bind(host string, port int) i64

@[intrinsic: 'vira_net_udp_send_to']
fn c_udp_send_to(fd i64, buf []u8, len int, host string, port int) int

@[intrinsic: 'vira_net_udp_recv_from']
fn c_udp_recv_from(fd i64, mut buf []u8, max_len int) int

@[intrinsic: 'vira_net_udp_last_sender']
fn c_udp_last_sender() string

@[intrinsic: 'vira_net_local_addr']
fn c_udp_local_addr(fd i64) string

pub struct UdpPacket {
pub:
	len int
	sender SocketAddr
}

pub struct UdpSocket {
pub mut:
	fd i64
	addr SocketAddr
	is_open bool
}

pub fn UdpSocket.bind(addr string) !UdpSocket {
	parsed := SocketAddr.parse(addr) or {
		return error(err)
	}
	fd := c_udp_bind(parsed.ip, parsed.port)
	if fd < 0 {
		return error('failed to bind UDP socket on ${addr}')
	}
	return UdpSocket{
		fd: fd,
		addr: parsed,
		is_open: true,
	}
}

pub fn (mut u UdpSocket) send_to(buf []u8, dest_addr string) !int {
	if !u.is_open || u.fd < 0 {
		return error('UDP socket is closed')
	}
	dest := SocketAddr.parse(dest_addr) or {
		return error(err)
	}
	n := c_udp_send_to(u.fd, buf, buf.len, dest.ip, dest.port)
	if n < 0 {
		return error('UDP send_to failed')
	}
	return n
}

pub fn (mut u UdpSocket) send_to_string(msg string, dest_addr string) !int {
	b := msg.bytes()
	n := u.send_to(b, dest_addr) or {
		return error(err)
	}
	return n
}

pub fn (mut u UdpSocket) recv_from(mut buf []u8) !UdpPacket {
	if !u.is_open || u.fd < 0 {
		return error('UDP socket is closed')
	}
	n := c_udp_recv_from(u.fd, mut buf, buf.cap)
	if n < 0 {
		return error('UDP recv_from failed')
	}
	sender_str := c_udp_last_sender()
	sender_addr := SocketAddr.parse(sender_str) or {
		SocketAddr.new('0.0.0.0', 0)
	}
	return UdpPacket{
		len: n,
		sender: sender_addr,
	}
}

pub fn (mut u UdpSocket) set_nonblocking(nonblocking bool) !bool {
	if !u.is_open || u.fd < 0 { return error('UDP socket is closed') }
	res := c_net_set_nonblocking(u.fd, nonblocking)
	if res != 0 { return error('failed to set nonblocking on UDP socket') }
	return true
}

pub fn (mut u UdpSocket) set_timeout(read_ms i64, write_ms i64) !bool {
	if !u.is_open || u.fd < 0 { return error('UDP socket is closed') }
	res := c_net_set_timeout(u.fd, read_ms, write_ms)
	if res != 0 { return error('failed to set timeout on UDP socket') }
	return true
}

pub fn (u UdpSocket) local_addr() !SocketAddr {
	if !u.is_open || u.fd < 0 { return error('UDP socket is closed') }
	addr_str := c_udp_local_addr(u.fd)
	if addr_str.len == 0 {
		return error('failed to get UDP local address')
	}
	parsed := SocketAddr.parse(addr_str) or {
		return error(err)
	}
	return parsed
}

pub fn (mut u UdpSocket) close() !bool {
	if !u.is_open || u.fd < 0 {
		return true
	}
	res := c_tcp_close(u.fd)
	u.is_open = false
	u.fd = -1
	if res != 0 {
		return error('failed to close UDP socket')
	}
	return true
}
