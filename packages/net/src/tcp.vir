module net

import time

@[intrinsic: 'vira_net_tcp_listen']
fn c_tcp_listen(host string, port int, backlog int) i64

@[intrinsic: 'vira_net_tcp_accept']
fn c_tcp_accept(server_fd i64) i64

@[intrinsic: 'vira_net_tcp_connect']
fn c_tcp_connect(host string, port int, timeout_ms i64) i64

@[intrinsic: 'vira_net_tcp_read']
fn c_tcp_read(fd i64, mut buf []u8, max_len int) int

@[intrinsic: 'vira_net_tcp_write']
fn c_tcp_write(fd i64, buf []u8, len int) int

@[intrinsic: 'vira_net_tcp_close']
fn c_tcp_close(fd i64) int

@[intrinsic: 'vira_net_tcp_shutdown']
fn c_tcp_shutdown(fd i64, how int) int

@[intrinsic: 'vira_net_peer_addr']
fn c_tcp_peer_addr(fd i64) string

@[intrinsic: 'vira_net_local_addr']
fn c_tcp_local_addr(fd i64) string

@[intrinsic: 'vira_net_set_nonblocking']
fn c_net_set_nonblocking(fd i64, nonblocking bool) int

@[intrinsic: 'vira_net_set_nodelay']
fn c_net_set_nodelay(fd i64, nodelay bool) int

@[intrinsic: 'vira_net_set_reuseaddr']
fn c_net_set_reuseaddr(fd i64, reuse bool) int

@[intrinsic: 'vira_net_set_timeout']
fn c_net_set_timeout(fd i64, read_ms i64, write_ms i64) int

@[intrinsic: 'vira_net_tcp_read_append']
fn c_tcp_read_append(fd i64, mut dst []u8, max_len int) int

@[intrinsic: 'vira_net_tcp_write_at']
fn c_tcp_write_at(fd i64, buf []u8, off int, len int) int

@[intrinsic: 'vira_net_buf_append_str']
fn c_buf_append_str(mut dst []u8, s string) int

@[intrinsic: 'vira_net_buf_append_bytes']
fn c_buf_append_bytes(mut dst []u8, src []u8) int

@[intrinsic: 'vira_net_buf_find']
fn c_buf_find(buf []u8, from int, needle string) int

@[intrinsic: 'vira_slice_u8_new']
fn c_slice_u8_new(cap int) []u8

pub fn new_bytes(cap int) []u8 {
	return c_slice_u8_new(cap)
}

pub struct TcpStream {
pub mut:
	fd i64
	is_open bool
	rx_buf []u8
	rx_pos int
	rx_len int
}

pub fn TcpStream.connect(addr string) !TcpStream {
	parsed := SocketAddr.parse(addr) or {
		return error(err)
	}
	fd := c_tcp_connect(parsed.ip, parsed.port, 0)
	if fd < 0 {
		return error('failed to connect to ${addr}')
	}
	return TcpStream{
		fd: fd,
		is_open: true,
		rx_buf: []u8{},
		rx_pos: 0,
		rx_len: 0,
	}
}

pub fn TcpStream.connect_timeout(addr string, timeout_ms i64) !TcpStream {
	parsed := SocketAddr.parse(addr) or {
		return error(err)
	}
	fd := c_tcp_connect(parsed.ip, parsed.port, timeout_ms)
	if fd < 0 {
		return error('connection to ${addr} timed out or failed')
	}
	return TcpStream{
		fd: fd,
		is_open: true,
		rx_buf: []u8{},
		rx_pos: 0,
		rx_len: 0,
	}
}

pub fn (mut s TcpStream) read(mut buf []u8) !int {
	if !s.is_open || s.fd < 0 {
		return error('socket is closed')
	}
	rem_buffered := s.rx_len - s.rx_pos
	if rem_buffered > 0 {
		mut can_copy := buf.cap
		if rem_buffered < can_copy {
			can_copy = rem_buffered
		}
		mut i := 0
		for i < can_copy {
			buf.push(s.rx_buf[s.rx_pos + i])
			i = i + 1
		}
		s.rx_pos = s.rx_pos + can_copy
		return can_copy
	}
	n := c_tcp_read(s.fd, mut buf, buf.cap)
	if n < 0 {
		return error('socket read error')
	}
	return n
}

pub fn (mut s TcpStream) read_byte() !u8 {
	if !s.is_open || s.fd < 0 {
		return error('socket is closed')
	}
	if s.rx_pos >= s.rx_len {
		if s.rx_buf.cap == 0 {
			s.rx_buf = c_slice_u8_new(4096)
		}
		n := c_tcp_read(s.fd, mut s.rx_buf, 4096)
		if n == -2 {
			// read timeout (SO_RCVTIMEO) or nothing yet on a non-blocking socket
			return error('timeout')
		}
		if n <= 0 {
			return error('EOF')
		}
		s.rx_pos = 0
		s.rx_len = n
	}
	b := s.rx_buf[s.rx_pos]
	s.rx_pos = s.rx_pos + 1
	return b
}

pub fn (mut s TcpStream) read_line() !string {
	mut line_bytes := []u8{}
	for true {
		b := s.read_byte() or {
			if line_bytes.len > 0 {
				return line_bytes.to_string()
			}
			return error(err)
		}
		if b == 10 {
			if line_bytes.len > 0 && line_bytes[line_bytes.len - 1] == 13 {
				line_bytes.pop()
			}
			return line_bytes.to_string()
		}
		line_bytes.push(b)
	}
	return ''
}

// Like read_line, but fails once the line exceeds max_len bytes (so a peer
// cannot grow memory without bound by never sending a newline) or, when
// deadline_ms > 0, once time.now_ms() passes it (so a peer cannot hold the
// caller by sending one byte just inside each read timeout).
pub fn (mut s TcpStream) read_line_limit(max_len int, deadline_ms i64) !string {
	return s.read_line_limit_idle(max_len, deadline_ms, true)!
}

// Like read_line_limit; with wait_idle false, a read timeout before the first
// byte of the line fails at once with 'timeout' (the pre-T-092 behaviour), so
// a keep-alive server with a short read timeout can drop idle connections.
// Once a byte has arrived, pauses are retried until the deadline.
pub fn (mut s TcpStream) read_line_limit_idle(max_len int, deadline_ms i64, wait_idle bool) !string {
	mut line_bytes := []u8{}
	for true {
		if deadline_ms > 0 && time.now_ms() > deadline_ms {
			return error('deadline passed')
		}
		b := s.read_byte() or {
			if deadline_ms > 0 && time.now_ms() > deadline_ms {
				return error('deadline passed')
			}
			if deadline_ms > 0 && err == 'timeout' && (wait_idle || line_bytes.len > 0) {
				// a pause shorter than the deadline: keep waiting
				continue
			}
			if line_bytes.len > 0 {
				return line_bytes.to_string()
			}
			return error(err)
		}
		if b == 10 {
			if line_bytes.len > 0 && line_bytes[line_bytes.len - 1] == 13 {
				line_bytes.pop()
			}
			return line_bytes.to_string()
		}
		if line_bytes.len >= max_len {
			return error('line longer than ${max_len} bytes')
		}
		line_bytes.push(b)
	}
	return ''
}

pub fn (mut s TcpStream) read_exact(n int) !string {
	mut b := []u8{}
	mut i := 0
	for i < n {
		byte_val := s.read_byte() or {
			return error(err)
		}
		b.push(byte_val)
		i = i + 1
	}
	return b.to_string()
}

pub fn (mut s TcpStream) read_all() !string {
	mut acc := []u8{}
	mut chunk := c_slice_u8_new(4096)
	for true {
		n := s.read(mut chunk) or {
			break
		}
		if n <= 0 {
			break
		}
		mut i := 0
		for i < n {
			acc.push(chunk[i])
			i = i + 1
		}
		chunk.clear()
	}
	return acc.to_string()
}

pub fn (mut s TcpStream) write(buf []u8) !int {
	if !s.is_open || s.fd < 0 {
		return error('socket is closed')
	}
	// send() may take only part of the buffer (a write timeout, a signal, a
	// non-blocking socket): keep going until all of it is sent.
	mut off := 0
	for off < buf.len {
		n := c_tcp_write_at(s.fd, buf, off, buf.len - off)
		if n == -2 {
			return error('socket write timed out after ${off} of ${buf.len} bytes')
		}
		if n <= 0 {
			return error('socket write error')
		}
		off += n
	}
	return off
}

// Non-blocking read for event loops: appends what is available (at most
// max_len bytes) to the end of `dst`. Returns the bytes appended, 0 when
// nothing is available yet, and an error at end of stream or on failure.
pub fn (mut s TcpStream) read_append(mut dst []u8, max_len int) !int {
	if !s.is_open || s.fd < 0 {
		return error('socket is closed')
	}
	n := c_tcp_read_append(s.fd, mut dst, max_len)
	if n == -2 {
		return 0
	}
	if n == 0 {
		return error('EOF')
	}
	if n < 0 {
		return error('socket read error')
	}
	return n
}

// Non-blocking write for event loops: sends buf[off..off+len) without
// copying. Returns the bytes sent, possibly fewer than len and 0 when the
// socket buffer is full; an error when the connection is gone.
pub fn (mut s TcpStream) write_at(buf []u8, off int, len int) !int {
	if !s.is_open || s.fd < 0 {
		return error('socket is closed')
	}
	n := c_tcp_write_at(s.fd, buf, off, len)
	if n == -2 {
		return 0
	}
	if n < 0 {
		return error('socket write error')
	}
	return n
}

pub fn (mut s TcpStream) write_string(str string) !int {
	b := str.bytes()
	n := s.write(b) or {
		return error(err)
	}
	return n
}

pub fn (mut s TcpStream) write_str(str string) !int {
	n := s.write_string(str) or {
		return error(err)
	}
	return n
}

pub fn (mut s TcpStream) read_string(max_len int) !string {
	mut b := c_slice_u8_new(max_len)
	n := s.read(mut b) or {
		return error(err)
	}
	if n <= 0 {
		return ''
	}
	return b.to_string()
}

pub fn (mut s TcpStream) set_nodelay(nodelay bool) !bool {
	if !s.is_open || s.fd < 0 { return error('socket is closed') }
	res := c_net_set_nodelay(s.fd, nodelay)
	if res != 0 { return error('failed to set TCP_NODELAY') }
	return true
}

pub fn (mut s TcpStream) set_nonblocking(nonblocking bool) !bool {
	if !s.is_open || s.fd < 0 { return error('socket is closed') }
	res := c_net_set_nonblocking(s.fd, nonblocking)
	if res != 0 { return error('failed to set nonblocking') }
	return true
}

pub fn (mut s TcpStream) set_timeout(read_ms i64, write_ms i64) !bool {
	if !s.is_open || s.fd < 0 { return error('socket is closed') }
	res := c_net_set_timeout(s.fd, read_ms, write_ms)
	if res != 0 { return error('failed to set socket timeout') }
	return true
}

pub fn (s TcpStream) peer_addr() !SocketAddr {
	if !s.is_open || s.fd < 0 { return error('socket is closed') }
	addr_str := c_tcp_peer_addr(s.fd)
	if addr_str.len == 0 {
		return error('failed to get peer address')
	}
	parsed := SocketAddr.parse(addr_str) or {
		return error(err)
	}
	return parsed
}

pub fn (s TcpStream) local_addr() !SocketAddr {
	if !s.is_open || s.fd < 0 { return error('socket is closed') }
	addr_str := c_tcp_local_addr(s.fd)
	if addr_str.len == 0 {
		return error('failed to get local address')
	}
	parsed := SocketAddr.parse(addr_str) or {
		return error(err)
	}
	return parsed
}

pub fn (mut s TcpStream) shutdown(how int) !bool {
	if !s.is_open || s.fd < 0 { return true }
	res := c_tcp_shutdown(s.fd, how)
	if res != 0 { return error('failed to shutdown socket') }
	return true
}

pub fn (mut s TcpStream) close() !bool {
	if !s.is_open || s.fd < 0 {
		return true
	}
	res := c_tcp_close(s.fd)
	s.is_open = false
	s.fd = -1
	if res != 0 {
		return error('failed to close socket')
	}
	return true
}

pub struct TcpListener {
pub mut:
	fd i64
	addr SocketAddr
	is_open bool
}

pub fn TcpListener.bind(addr string) !TcpListener {
	parsed := SocketAddr.parse(addr) or {
		return error(err)
	}
	fd := c_tcp_listen(parsed.ip, parsed.port, 128)
	if fd < 0 {
		return error('failed to bind and listen on ${addr}')
	}
	return TcpListener{
		fd: fd,
		addr: parsed,
		is_open: true,
	}
}

pub fn (mut l TcpListener) accept() !TcpStream {
	if !l.is_open || l.fd < 0 {
		return error('listener is closed')
	}
	client_fd := c_tcp_accept(l.fd)
	if client_fd < 0 {
		return error('failed to accept incoming connection')
	}
	return TcpStream{
		fd: client_fd,
		is_open: true,
		rx_buf: []u8{},
		rx_pos: 0,
		rx_len: 0,
	}
}

pub fn (mut l TcpListener) set_nonblocking(nonblocking bool) !bool {
	if !l.is_open || l.fd < 0 { return error('listener is closed') }
	res := c_net_set_nonblocking(l.fd, nonblocking)
	if res != 0 { return error('failed to set nonblocking on listener') }
	return true
}

pub fn (l TcpListener) local_addr() !SocketAddr {
	if !l.is_open || l.fd < 0 { return error('listener is closed') }
	addr_str := c_tcp_local_addr(l.fd)
	if addr_str.len == 0 {
		return error('failed to get listener local address')
	}
	parsed := SocketAddr.parse(addr_str) or {
		return error(err)
	}
	return parsed
}

pub fn (mut l TcpListener) close() !bool {
	if !l.is_open || l.fd < 0 {
		return true
	}
	res := c_tcp_close(l.fd)
	l.is_open = false
	l.fd = -1
	if res != 0 {
		return error('failed to close listener')
	}
	return true
}

// Appends the bytes of `s` to `dst` with one copy (NUL bytes included).
// Returns the new length; an error when the buffer cannot grow.
pub fn append_string(mut dst []u8, s string) !int {
	n := c_buf_append_str(mut dst, s)
	if n < 0 {
		return error('cannot grow buffer to ${dst.len + s.len} bytes')
	}
	return n
}

// Index of the first `needle` in buf[from..], or -1.
pub fn find_bytes(buf []u8, from int, needle string) int {
	return c_buf_find(buf, from, needle)
}

// Appends the bytes of `src` to `dst` with one copy. Returns the new length.
pub fn append_bytes(mut dst []u8, src []u8) !int {
	n := c_buf_append_bytes(mut dst, src)
	if n < 0 {
		return error('cannot grow buffer to ${dst.len + src.len} bytes')
	}
	return n
}
