module time

pub const NANOSECOND: i64 = 1
pub const MICROSECOND: i64 = 1000
pub const MILLISECOND: i64 = 1000000
pub const SECOND: i64 = 1000000000
pub const MINUTE: i64 = 60000000000
pub const HOUR: i64 = 3600000000000

@[intrinsic: 'vira_time_now_unix']
fn c_now_unix() i64

@[intrinsic: 'vira_time_now_ns']
fn c_now_ns() i64

@[intrinsic: 'vira_time_monotonic_ns']
fn c_monotonic_ns() i64

@[intrinsic: 'vira_time_sleep_ms']
fn c_sleep_ms(ms i64) void

@[intrinsic: 'vira_time_sleep_us']
fn c_sleep_us(us i64) void

@[intrinsic: 'vira_time_strftime']
fn c_strftime(fmt string, unix_sec i64, utc bool) !string

pub fn now_unix() i64 {
	return c_now_unix()
}

pub fn now_ms() i64 {
	return c_now_ns() / 1000000
}

pub fn now_ns() i64 {
	return c_now_ns()
}

pub fn monotonic_ns() i64 {
	return c_monotonic_ns()
}

pub fn sleep_ms(ms int) void {
	c_sleep_ms(i64(ms))
}

pub fn sleep_ms_i64(ms i64) void {
	c_sleep_ms(ms)
}

pub fn sleep_us(us int) void {
	c_sleep_us(i64(us))
}

pub fn format(fmt string, unix_sec i64, utc bool) !string {
	res := c_strftime(fmt, unix_sec, utc) or {
		return error(err)
	}
	return res
}

pub struct Duration {
pub mut:
	nanos i64
}

pub fn Duration.from_nanos(n i64) Duration {
	return Duration{ nanos: n }
}

pub fn Duration.from_millis(ms i64) Duration {
	return Duration{ nanos: ms * MILLISECOND }
}

pub fn Duration.from_secs(secs i64) Duration {
	return Duration{ nanos: secs * SECOND }
}

pub fn (d Duration) millis() i64 {
	return d.nanos / MILLISECOND
}

pub fn (d Duration) secs() i64 {
	return d.nanos / SECOND
}
